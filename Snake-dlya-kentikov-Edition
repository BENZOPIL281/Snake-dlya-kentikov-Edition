const MAX_HEARTS = 3;       /* потолок сердец — больше не выдаётся никогда */
const AMMO_MAX   = 30;      /* потолок патронов */
const BULLET_SPEED = 620;   /* пикс/сек — пуля летит от головы к стене */
const ROLL_AMMO = 20;       /* шанс патрона 1 к 20 */
const ROLL_MED  = 15;       /* шанс аптечки 1 к 15 */
const BARREL_CAP = 26;      /* больше бочек арена не переваривает */

/* ---------------------------------------------------------- РЕЖИМЫ СКОРОСТИ ==
   Выбираются в лобби. От режима зависит темп змейки, как быстро арена
   обрастает и как часто сыплется порча.
   ============================================================================ */
const MODES = [
  /* soulDelay: новая сфера появляется СРАЗУ после сбора (0.15с),
     как и просили — на арене всегда ровно одна. */
  /* huntCap   — сколько Врагов держится на арене одновременно
     huntSpeed — скорость их шага (клеток в секунду)
     huntAdd   — сколько новых лезет за каждый этап
     huntersFrom — с какого этапа они вообще появляются */
  { id:'slabak',   name:'НИЗКАЯ',          col:'#7cf0ff', speed:5.0,
    esc0:14, escStep:50, blocks:1, barrels:1, huntersFrom:3,
    huntCap:2, huntSpeed:0.55, huntAdd:1,
    corr:12.0, corrMin:7.5, pickCd:1.4, medCap:2, ammoCap:2, soulDelay:0.15 },

  { id:'chervyak', name:'СРЕДНЯЯ',         col:'#8fe25c', speed:6.3,
    esc0:11, escStep:42, blocks:2, barrels:2, huntersFrom:2,
    huntCap:4, huntSpeed:0.80, huntAdd:1,
    corr:9.5,  corrMin:5.5, pickCd:1.2, medCap:2, ammoCap:2, soulDelay:0.15 },

  { id:'sinya',    name:'ВЫСОКАЯ',         col:'#ffcf3c', speed:7.9,
    esc0:9,  escStep:35, blocks:2, barrels:3, huntersFrom:1,
    huntCap:6, huntSpeed:1.05, huntAdd:2,
    corr:7.5,  corrMin:4.5, pickCd:1.1, medCap:2, ammoCap:1, soulDelay:0.15 },

  { id:'krutyak',  name:'ОЧЕНЬ ВЫСОКАЯ',   col:'#ff3b18', speed:9.5,
    esc0:7,  escStep:28, blocks:3, barrels:4, huntersFrom:1,
    huntCap:9, huntSpeed:1.35, huntAdd:3,
    corr:5.8,  corrMin:3.5, pickCd:1.0, medCap:2, ammoCap:1, soulDelay:0.15 }
];      /* больше бочек арена не переваривает */

/* ------------------------------------------------------------------ утилы */
const rnd  = (n) => (Math.random()*n)|0;
const clamp= (v,a,b) => v<a?a:v>b?b:v;
const pick = (a) => a[(Math.random()*a.length)|0];

/* вспомогательная функция: создать canvas нужного размера */
function mkCanvas(w,h){ const c=document.createElement('canvas'); c.width=w; c.height=h; return c; }

/* ---------------------------------------------------------------------------
   ЕДИНАЯ КАРТА — «СТРАНА ЧУДЕС».
   Поле полностью чёрное. Стены чёрные, но по их краю бежит радужная кайма:
   цвет зависит от позиции клетки и от времени, поэтому перелив идёт
   по периметру и по всем блокам разом.
   ========================================================================== */

/* чёрная плитка стены — почти без деталей, только чтобы читался объём */
function texBlackWall(){
  const c = mkCanvas(TILE,TILE), g = c.getContext('2d');
  g.fillStyle = '#050507'; g.fillRect(0,0,TILE,TILE);

  for (let i=0;i<34;i++){
    const v = 6 + rnd(6);
    g.fillStyle = `rgb(${v},${v},${v+1})`;
    g.fillRect(rnd(TILE), rnd(TILE), 2+rnd(5), 2+rnd(4));
  }
  return c;
}

/* чёрный пол — чуть светлее стен, с еле заметной сеткой */
function texBlackFloor(seed){
  const c = mkCanvas(TILE,TILE), g = c.getContext('2d');
  g.fillStyle = '#08080b'; g.fillRect(0,0,TILE,TILE);

  for (let i=0;i<60;i++){
    const v = 8 + rnd(7) + seed;
    g.fillStyle = `rgb(${v},${v},${v+2})`;
    g.fillRect(rnd(TILE), rnd(TILE), 1+rnd(4), 1+rnd(3));
  }
  g.strokeStyle = 'rgba(255,255,255,.03)';
  g.lineWidth = 1;
  g.strokeRect(.5,.5,TILE-1,TILE-1);
  return c;
}

/* единственная карта */
const MAPS = [
  { id:'wonder', name:'СТРАНА ЧУДЕС', col:'#c06cff', desc:'чёрное поле и радужные стены' }
];

const TEXCACHE = {};

function buildTexSet(id){
  if (TEXCACHE[id]) return Object.assign({}, TEXCACHE[id]);
  const set = {
    brick:  texBlackWall(),
    tech:   texBlackWall(),
    floorA: texBlackFloor(0),
    floorB: texBlackFloor(3)
  };
  TEXCACHE[id] = set;
  return set;
}

/* TXT — рабочая копия, а не ссылка на кэш */
const TXT = Object.assign({}, buildTexSet('wonder'));

function applyMapTextures(id){
  const set = buildTexSet(id);
  TXT.brick  = set.brick;
  TXT.tech   = set.tech;
  TXT.floorA = set.floorA;
  TXT.floorB = set.floorB;
  paintArena();
}

/* ===========================================================================
   МУЗЫКА И ЖИВОЙ ЭКВАЛАЙЗЕР
   Песня играет в лобби, глушится в забеге. AnalyserNode снимает спектр
   прямо с потока — полоски пляшут именно под то, что сейчас звучит.
   TRACKS — массив: новая песня добавляется одной строкой.
   ========================================================================== */
/* ===========================================================================
   МУЗЫКА

   Файл грузим целиком через fetch и декодируем в AudioBuffer. Старый подход
   с <audio> + createMediaElementSource отдавал тишину: без CORS-заголовков
   браузер помечает поток как «испорченный». Здесь либо всё работает, либо
   честно падаем в запасной путь — обычный <audio> без анализатора.
   ========================================================================== */
/* ── ВСТРОЕННЫЕ ТРЕКИ ──
   Порядок важен: первый в списке — тот, что играет по умолчанию.

   ПРО ПРОБЕЛЫ В ИМЕНИ. Раньше путь подставлялся в fetch как есть, и
   браузер читал пробелы и слэши как разделители — запрос уходил в 404.
   Теперь имя файла кодируется отдельно от пути: encodeURIComponent
   превращает пробел в %20, а случайный слэш в имени — в %2F. */
const TRACKS = [
  { url:'https://r2.syntx.ai/user_3589464033138297336/llms/6e9ea6343db8e8193e79552c76cae847_Pooka - MAYBE SOMUGENMIRAI.mp3',
    title:'Pooka - MAYBE SO/MUGENMIRAI' },

  { url:'https://r2.syntx.ai/user_3589464033138297336/llms/ddf00d0e3f2948b83dfe9ce7109a14ea_Pooka - nee.mp3',
    title:'Pooka - nee' }
];

/* Кодируем ТОЛЬКО имя файла, путь оставляем как есть. */
function trackUrl(u){
  const i = u.lastIndexOf('/');
  if (i < 0) return encodeURIComponent(u);
  return u.slice(0, i + 1) + encodeURIComponent(u.slice(i + 1));
}

const Music = (() => {
  let ac = null;
  let analyser = null, gain = null, buf = null, srcNode = null;
  let fallbackEl = null;
  let want = false, vol = 0.55;
  let mode = 'idle';

  /* ── РЕВЕРБ ── */
  const VERB_SEND = 0.30;
  const VERB_RET  = 1.00;
  let wantVerb = false;
  let verbSend = null, verbRet = null;

  /* ── СВОЯ МУЗЫКА ──
     userBuf  — раскодированный mp3 игрока (живёт только в памяти:
                браузер не даёт сохранить файл между сессиями);
     userName — имя файла без расширения, оно и показывается в лобби;
     userUrl  — object-URL того же файла для запасного пути через <audio>;
     srcMode  — что играть: только игровую, только свою или обе по кругу. */
  let userBuf = null, userName = '', userUrl = null;
  let srcMode = 'game';           /* 'game' | 'user' | 'both' */
  let plIdx = 0;                  /* какой трек плейлиста играет сейчас */
  let playMode = 'all';           /* 'one' | 'all' | 'shuffle' */
  let paused = false;             /* пауза по кнопке, а не остановка */
  let gameBuf = null;             /* кэш игрового трека */
  let curBuf = null;              /* буфер, который звучит прямо сейчас */
  let onTitle = null;             /* сюда UI вешает обновление подписи */

  /* Плейлист строится из режима. Если выбран «только своя», но файла нет —
     честно откатываемся к игровой, иначе была бы тишина. */
  function playlist(){
    const out = [];

    /* игровые треки идут в том порядке, в каком объявлены в TRACKS */
    if (srcMode === 'game' || srcMode === 'both'){
      for (let i = 0; i < TRACKS.length; i++){
        out.push({ kind:'game', idx:i, title: TRACKS[i].title });
      }
    }
    if ((srcMode === 'user' || srcMode === 'both') && userBuf){
      out.push({ kind:'user', idx:-1, title: userName || 'своя музыка' });
    }
    if (!out.length){
      out.push({ kind:'game', idx:0, title: TRACKS[0].title });
    }
    return out;
  }

  function current(){
    const pl = playlist();
    if (plIdx >= pl.length) plIdx = 0;
    return pl[plIdx];
  }

  /* Длительность текущего трека в секундах (0, пока не загружен). */
  function duration(){
    return curBuf ? (curBuf.duration || 0) : 0;
  }

  /* Переход к следующему треку.
     manual=true — нажали «вперёд»; тогда режим «одна и та же» не мешает. */
  function advance(manual){
    const pl = playlist();

    if (pl.length < 2){
      /* один трек в плейлисте: просто начинаем заново */
      offset = 0;
      playBuffer().catch(()=>playElement());
      return;
    }

    if (playMode === 'one' && !manual){
      offset = 0;                       /* повтор той же песни */
    } else if (playMode === 'shuffle'){
      /* случайный, но не тот же самый */
      let n = plIdx;
      for (let k = 0; k < 8 && n === plIdx; k++){
        n = Math.floor(Math.random() * pl.length);
      }
      plIdx = n;
      offset = 0;
    } else {
      plIdx = (plIdx + 1) % pl.length;  /* по порядку */
      offset = 0;
    }

    if (fallbackEl){ fallbackEl._src = null; }
    notifyTitle();
    playBuffer().catch(()=>playElement());
  }

  function notifyTitle(){
    if (!onTitle) return;
    try { onTitle(current().title); } catch(e){}
  }

  /* останавливаем источник, СНИМАЯ обработчик конца:
     иначе stop() вызовет onended и запустит следующий трек */
  function stopSrc(){
    if (!srcNode) return;
    try { srcNode.onended = null; } catch(e){}
    try { srcNode.stop(); } catch(e){}
    srcNode = null;
  }

  /* ── РЕВЕРБ ──
     В забеге музыка звучит «в помещении»: к сухому сигналу подмешивается
     хвост отражений. В лобби и на паузе — обычный чистый звук.
     Уровни подобраны так, чтобы общая громкость не росла. */
  /* Реверб подмешивается ПОВЕРХ прямого сигнала, а не вместо него.
     Посыл 0.35 даёт сумму sqrt(1 + 0.35²) = 1.06 — на 0.5 дБ громче,
     зато прямой путь никогда не отключается. */
  /* Сеть задержек усиливает в 1.56x (измерено на шуме).
     Возврат 1/1.56 = 0.64 приводит мокрый сигнал к уровню посыла. */
  let reverbReady = false;   /* удалось ли собрать реверб */

  /* позиция воспроизведения, чтобы музыка НЕ начиналась заново
     при выходе в лобби или на экран смерти */
  let startedAt = 0;        /* время контекста, когда запустили источник */
  let offset = 0;           /* с какой секунды трека стартовали */
  let live = false;         /* источник РЕАЛЬНО звучит прямо сейчас */

  /* плавно подводим посыл к нужному уровню — без щелчков и скачков */
  /* Управляет только посылом. Сухой путь не трогаем вообще —
     он идёт напрямую и работает при любых обстоятельствах. */
  function applyVerb(instant){
    if (!verbSend || !ac) return;
    const t  = ac.currentTime;
    const to = wantVerb ? VERB_SEND : 0;

    try {
      verbSend.gain.cancelScheduledValues(t);
      if (instant){
        verbSend.gain.value = to;
      } else {
        /* плавно, без щелчка при входе в паузу */
        verbSend.gain.setTargetAtTime(to, t, 0.12);
      }
    } catch(e){
      try { verbSend.gain.value = to; } catch(_){}
    }
  }

  function pos(){
    if (mode !== 'buffer' || !ac || !curBuf) return offset;
    const d = curBuf.duration || 1;
    let p = offset + (ac.currentTime - startedAt);
    return ((p % d) + d) % d;
  }

  function ctxOf(){
    if (ac) return ac;
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return null;
    try { ac = new AC(); } catch(e){ ac = null; }
    return ac;
  }

  /* Музыка всегда звучит на той громкости, что выставил игрок.
     Раньше в забеге она автоматически приглушалась до 22% — этого
     больше нет, тише становится только от самого ползунка. */
  function eff(){ return vol; }

  /* ── РЕАЛЬНОЕ СОСТОЯНИЕ КОНТЕКСТА ──
     resume() асинхронный: сразу после вызова state ещё 'suspended',
     хотя звук вот-вот пойдёт. Поэтому не проверяем state синхронно,
     а следим за событием statechange — оно приходит в момент пробуждения. */
  let ctxReady = false;              /* контекст реально работает */
  let onUnlock = null;               /* сюда UI вешает реакцию на пробуждение */

  function watchState(a){
    if (!a || a._watched) return;
    a._watched = true;

    const sync = () => {
      ctxReady = (a.state === 'running');
      if (ctxReady && want) live = true;
      if (a.state === 'suspended') live = false;
      if (onUnlock){ try { onUnlock(ctxReady); } catch(e){} }
    };

    try { a.addEventListener('statechange', sync); } catch(e){}
    sync();
  }

  /* Загрузка текущего трека плейлиста.
     Свой mp3 уже раскодирован при выборе файла — его берём готовым.
     Игровой качаем один раз и держим в кэше. */
  /* ══════════════ ИМПУЛЬС ПОМЕЩЕНИЯ ══════════════

     В забеге музыка звучит «в комнате». Гладкий диффузный хвост,
     отфильтрованный дважды: мягкие поверхности гасят верхи быстрее
     низов, поэтому хвост тёмный, без шипения и писка. */
  function makeRoomIR(a, seconds){
    const rate = a.sampleRate;
    const len  = Math.max(1, Math.floor(rate * seconds));
    const ir   = a.createBuffer(2, len, rate);

    const pre = Math.floor(rate * 0.015);

    for (let ch = 0; ch < 2; ch++){
      const d = ir.getChannelData(ch);

      /* mulberry32: целочисленная арифметика, без переполнения */
      let st = (ch ? 7717 : 3313) >>> 0;
      const rnd = () => {
        st = (st + 0x6D2B79F5) >>> 0;
        let t = st;
        t = Math.imul(t ^ (t >>> 15), t | 1);
        t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };

      /* два каскада ФНЧ = −12 дБ на октаву, срез 1100 Гц */
      const cut = 1100;
      const k1 = Math.exp(-2 * Math.PI * cut / rate);
      let lp1 = 0;

      for (let i = pre; i < len; i++){
        const t = (i - pre) / (len - pre);
        const env = Math.pow(1 - t, 2.2);
        const white = rnd() * 2 - 1;
        lp1 = (1 - k1) * white + k1 * lp1;
        d[i] = lp1 * env;
      }

      let y = 0;
      for (let i = pre; i < len; i++){
        y = (1 - k1) * d[i] + k1 * y;
        d[i] = y * 2.4;
      }

      /* плавные края: ступенька на границе сама по себе щелчок */
      const fi = Math.min(len - pre, Math.floor(rate * 0.012));
      for (let i = 0; i < fi; i++) d[pre + i] *= i / fi;

      const fo = Math.min(len, Math.floor(rate * 0.06));
      for (let i = 0; i < fo; i++) d[len - 1 - i] *= i / fo;
    }

    /* нормировка по энергии: сумма квадратов = 1 */
    let energy = 0;
    for (let ch = 0; ch < 2; ch++){
      const d = ir.getChannelData(ch);
      for (let i = 0; i < len; i++) energy += d[i] * d[i];
    }
    if (energy > 0){
      const g = 1 / Math.sqrt(energy);
      for (let ch = 0; ch < 2; ch++){
        const d = ir.getChannelData(ch);
        for (let i = 0; i < len; i++) d[i] *= g;
      }
    }
    return ir;
  }

  /* ── СБОРКА ГРАФА ──
     источник → громкость → анализатор → выход
                        ↘ посыл → свёртка → ФНЧ → возврат ↗ */
  function ensureGraph(){
    const a = ctxOf();
    if (!a) return null;
    watchState(a);
    if (analyser) return a;

    gain = a.createGain();
    gain.gain.value = eff();

    analyser = a.createAnalyser();
    analyser.fftSize = 1024;
    analyser.smoothingTimeConstant = 0.62;
    analyser.minDecibels = -95;
    analyser.maxDecibels = -10;
    buf = new Uint8Array(analyser.frequencyBinCount);

    /* ГЛАВНОЕ: цепочка источник → громкость → анализатор → выход.
       Без connect(gain → analyser) звук обрывается после громкости
       и в динамики не попадает. Эквалайзер при этом работает,
       потому что анализатор подключён к выходу отдельно. */
    gain.connect(analyser);
    analyser.connect(a.destination);

    /* ── РЕВЕРБ ── */
    verbSend = a.createGain();
    verbSend.gain.value = wantVerb ? VERB_SEND : 0;

    const conv = a.createConvolver();
    try { conv.normalize = false; } catch(_){}

    try {
      conv.buffer = makeRoomIR(a, 1.2);
      reverbReady = true;
    } catch(e){
      reverbReady = false;
    }

    /* ФНЧ на мокром пути — страховка от верхов */
    const wetLp = a.createBiquadFilter();
    wetLp.type = 'lowpass';
    wetLp.frequency.value = 2600;
    wetLp.Q.value = 0.5;

    verbRet = a.createGain();
    verbRet.gain.value = VERB_RET;

    analyser.connect(verbSend);
    verbSend.connect(conv);
    conv.connect(wetLp);
    wetLp.connect(verbRet);
    verbRet.connect(a.destination);

    return a;
  }

  /* Переключить зацикливание на живом источнике.
     Если источник не запущен — ничего не делаем: при следующем
     playBuffer() флаг выставится по текущему режиму. */
  function applyLoopMode(){
    if (!srcNode) return;
    const pl = playlist();
    const single = (playMode === 'one') || (pl.length === 1);

    try { srcNode.loop = single; } catch(e){}

    /* при переходе с зацикливания на очередь возвращаем обработчик
       конца, иначе трек просто оборвётся на последней секунде */
    if (!single && !srcNode.onended){
      srcNode.onended = () => {
        if (!want || !srcNode) return;
        srcNode = null;
        advance(false);
      };
    }
    if (single && srcNode.onended){
      try { srcNode.onended = null; } catch(e){}
    }
  }

  /* ── ЗАПУСК ТРЕКА ──
     Защита от параллельных запусков. Два playBuffer одновременно
     (клик по кнопке ловится и в capture, и в обработчике) давали
     двух сирот: один источник остановлен, но его onended жив. */
  /* ── МАШИНА СОСТОЯНИЙ ЗАПУСКА ──
     Вместо булева флага — счётчик поколений. Каждый запуск получает
     свой номер; результат устаревшего запуска отбрасывается. Так
     нельзя «застрять» в загрузке: новая попытка всегда получает
     свежий номер и не блокируется прошлой. */
  let launchToken = 0;
  let loading = false;
  let loadingSince = 0;

  async function playBuffer(){
    /* прошлая загрузка висит дольше восьми секунд — считаем её
       мёртвой: сеть отвалилась или декодер подавился файлом */
    if (loading && (Date.now() - loadingSince) > 8000){
      loading = false;
    }
    if (loading) return;

    const my = ++launchToken;
    loading = true;
    loadingSince = Date.now();
    try {
      await playBufferInner(my);
    } finally {
      /* снимаем флаг только если мы всё ещё последний запуск */
      if (my === launchToken) loading = false;
    }
  }

  async function playBufferInner(my){
    const a = ctxOf();
    if (!a) throw new Error('no ctx');

    /* resume() не ждём: вне жеста промис не резолвится никогда */
    if (a.state === 'suspended'){
      try { const r = a.resume(); if (r && r.catch) r.catch(()=>{}); } catch(e){}
    }

    mode = 'loading';
    const cur = current();

    let b;
    try {
      b = await loadBuffer();
    } catch(err){
      /* Загрузка сорвалась. mode оставлять в 'loading' нельзя:
         start() при нём молчит, и музыка больше не запустится. */
      if (my === launchToken){
        mode = 'idle';
        paused = false;
      }
      throw err;
    }
    if (!want) return;

    /* Пока качали файл, могли переключить трек или нажать паузу.
       Сверяемся: если нас обогнали — молча уходим, не трогая
       источник. Раньше здесь стояла рекурсия в playBuffer, и она
       натыкалась на собственный флаг загрузки. */
    if (my !== launchToken) return;

    const now = current();
    if (now.kind !== cur.kind || now.idx !== cur.idx) return;
    if (paused || !want) return;

    if (a.state === 'suspended'){
      try { const r = a.resume(); if (r && r.catch) r.catch(()=>{}); } catch(e){}
    }

    ensureGraph();
    gain.gain.value = eff();

    stopSrc();
    srcNode = a.createBufferSource();
    srcNode.buffer = b;
    curBuf = b;

    /* Один трек в плейлисте и режим «одна и та же» — зацикливаем
       силами самого источника. Иначе конец трека ловит onended. */
    const pl = playlist();
    const singleLoop = (playMode === 'one') || (pl.length === 1);
    srcNode.loop = singleLoop;

    if (!singleLoop){
      srcNode.onended = () => {
        if (!want || !srcNode) return;
        srcNode = null;
        advance(false);
      };
    }

    srcNode.connect(gain);

    const d = b.duration || 0;
    const from = d > 0 ? (offset % d) : 0;
    startedAt = a.currentTime;
    offset = from;
    srcNode.start(0, from);

    live = true;
    if (a.state === 'running') ctxReady = true;
    mode = 'buffer';
    paused = false;
    notifyTitle();
  }

  /* Кэш раскодированных игровых треков: индекс → AudioBuffer.
     Раньше был один слот, и при переключении трек качался заново. */
  const gameBufs = {};

  async function loadBuffer(){
    const cur = current();

    if (cur.kind === 'user'){
      if (!userBuf) throw new Error('нет своего файла');
      return userBuf;
    }

    if (gameBufs[cur.idx]) return gameBufs[cur.idx];

    const a = ctxOf();
    if (!a) throw new Error('no ctx');

    const res = await fetch(trackUrl(TRACKS[cur.idx].url), { mode:'cors' });
    if (!res.ok) throw new Error('http ' + res.status);
    const ab = await res.arrayBuffer();

    const buf = await new Promise((ok, no) => {
      let done = false;
      const good = b => { if (!done){ done = true; ok(b); } };
      const bad  = e => { if (!done){ done = true; no(e); } };
      try {
        const r = a.decodeAudioData(ab, good, bad);
        if (r && typeof r.then === 'function') r.then(good).catch(bad);
      } catch(e){ bad(e); }
    });

    gameBufs[cur.idx] = buf;
    return buf;
  }

  function playElement(){
    const cur = current();
    const url = cur.kind === 'user' ? userUrl : trackUrl(TRACKS[cur.idx].url);

    if (!fallbackEl){
      fallbackEl = new Audio();
      fallbackEl.preload = 'auto';
      fallbackEl.addEventListener('error', ()=>{ mode = 'error'; });
    }

    /* зацикливаем только когда трек один: иначе конец трека
       должен переключать на следующий, а не повторять этот */
    const pl = playlist();
    fallbackEl.loop = (playMode === 'one') || (pl.length === 1);

    if (!fallbackEl.loop && !fallbackEl._hooked){
      fallbackEl._hooked = true;
      fallbackEl.addEventListener('ended', () => {
        if (!want || fallbackEl.loop) return;
        advance(false);
      });
    }
    /* источник мог смениться — переставляем, только если правда другой */
    if (fallbackEl._src !== url){
      fallbackEl.src = url;
      fallbackEl._src = url;
    }
    fallbackEl.volume = clamp(eff(), 0, 1);
    const r = fallbackEl.play();
    if (r && r.catch) r.catch(()=>{ mode = 'error'; });
    mode = 'element';
  }

  return {
    start(){
      want = true;
      const a = ctxOf();
      if (!a){ playElement(); return; }

      /* Будим контекст на каждом вызове — это дёшево и безопасно.
         Раньше здесь висел await resume(): вне жеста промис не резолвился,
         и запуск не происходил до первого касания ползунка. */
      if (a.state === 'suspended'){
        try { const r = a.resume(); if (r && r.catch) r.catch(()=>{}); } catch(e){}
      }

      if (live && srcNode) return;        /* уже звучит */
      if (mode === 'element' && fallbackEl && !fallbackEl.paused) return;

      /* 'loading' — это ожидание сети. Уважаем его, только пока
         загрузка реально идёт. Если флаг снят, а mode остался
         'loading', значит предыдущая попытка оборвалась и надо
         пробовать заново — иначе музыка не заиграет никогда. */
      if (mode === 'loading' && loading) return;

      /* Пауза — это осознанное состояние игрока, а start() зовётся
         из любого жеста (в том числе из фазы перехвата клика).
         Если её сбрасывать здесь, обработчик кнопки «пауза» увидит
         уже перевёрнутое значение и сделает обратное действие.
         Возобновление — только через resumePlayback(). */
      if (paused) return;

      playBuffer().catch(()=>playElement());
    },

    /* разбудить контекст — вызывается из обработчиков жестов */
    resumeCtx(){
      const a = ctxOf();
      if (a && a.state === 'suspended'){
        try { const r = a.resume(); if (r && r.catch) r.catch(()=>{}); } catch(e){}
      }
    },

    /* позиция в секундах — пригодится и для отладки */
    get position(){ return pos(); },
    stop(){
      offset = pos();          /* запоминаем, где остановились */
      want = false;
      live = false;
      stopSrc();               /* снять onended, иначе поедет следующий трек */
      if (fallbackEl) fallbackEl.pause();
      mode = 'idle';
    },

    /* мягкая пауза без потери места */
    pause(){
      offset = pos();
      live = false;
      stopSrc();
      if (fallbackEl) fallbackEl.pause();
      mode = 'idle';
      /* want остаётся true — при возврате продолжим */
    },

    setVolume(v){
      vol = clamp(v, 0, 1);
      if (gain) gain.gain.value = eff();
      if (fallbackEl) fallbackEl.volume = clamp(eff(), 0, 1);
    },

    /* ── СВОЯ МУЗЫКА ──
       Принимает File из <input type=file>. Файл остаётся в памяти
       до перезагрузки страницы: браузер не даёт сохранить его насовсем. */
    async loadUserFile(file){
      const a = ctxOf();
      if (!a) throw new Error('нет аудиоконтекста');

      const ab = await file.arrayBuffer();
      const buf = await new Promise((ok, no) => {
        let done = false;
        const good = b => { if (!done){ done = true; ok(b); } };
        const bad  = e => { if (!done){ done = true; no(e); } };
        try {
          const r = a.decodeAudioData(ab.slice(0), good, bad);
          if (r && typeof r.then === 'function') r.then(good).catch(bad);
        } catch(e){ bad(e); }
      });

      /* старый object-URL освобождаем, иначе память течёт */
      if (userUrl){ try { URL.revokeObjectURL(userUrl); } catch(e){} }
      userUrl  = URL.createObjectURL(file);

      userBuf  = buf;
      userName = String(file.name || 'своя музыка').replace(/\.mp3$/i, '');

      /* по умолчанию после загрузки — только своя */
      srcMode = 'user';
      plIdx = 0;
      offset = 0;

      /* запасной путь тоже должен знать про новый файл */
      if (fallbackEl){ fallbackEl._src = null; }

      this.restart();
      notifyTitle();
      return { title: userName, seconds: buf.duration };
    },

    hasUser(){ return !!userBuf; },
    userTitle(){ return userName; },

    /* режим источника: 'game' | 'user' | 'both' */
    setSource(m){
      if (m !== 'game' && m !== 'user' && m !== 'both') return srcMode;
      srcMode = m;
      plIdx = 0;
      offset = 0;
      if (fallbackEl){ fallbackEl._src = null; }
      this.restart();
      notifyTitle();
      return srcMode;
    },
    get source(){ return srcMode; },

    /* перезапуск с текущим плейлистом (после смены режима или файла) */
    restart(){
      if (!want) { notifyTitle(); return; }
      const a = ctxOf();
      if (!a){ playElement(); notifyTitle(); return; }
      stopSrc();
      live = false;
      mode = 'idle';
      playBuffer().catch(()=>playElement());
    },

    /* ── ПЛЕЕР ── */

    /* длительность текущего трека в секундах */
    get duration(){ return duration(); },

    /* сколько прошло от начала */
    get elapsed(){
      if (paused) return offset;
      return pos();
    },

    /* сколько осталось */
    get remaining(){
      const d = duration();
      return d > 0 ? Math.max(0, d - this.elapsed) : 0;
    },

    /* идёт ли воспроизведение прямо сейчас */
    get paused(){ return paused; },

    /* пауза: источник останавливаем, позицию запоминаем */
    pausePlayback(){
      const d = duration();
      offset = d > 0 ? pos() : offset;   /* где остановились */
      paused = true;
      want = true;                        /* музыка включена, просто на паузе */
      live = false;
      stopSrc();
      if (fallbackEl) fallbackEl.pause();
      mode = 'idle';
      loading = false;                    /* пауза отменяет текущую загрузку */
      launchToken++;                      /* и делает её результат недействительным */
    },

    /* продолжить с того же места */
    resumePlayback(){
      const wasPaused = paused;
      paused = false;
      want = true;

      const a = ctxOf();
      if (a && a.state === 'suspended'){
        try { const r = a.resume(); if (r && r.catch) r.catch(()=>{}); } catch(e){}
      }

      /* Если источник уже звучит и это не снятие с паузы — ничего
         не делаем. Иначе перезапускаем с сохранённой позиции.
         Раньше здесь стоял ранний выход при paused===false, из-за
         чего кнопка «играть» не работала, если флаг успел сброситься. */
      if (!wasPaused && live && srcNode) return;

      playBuffer().catch(()=>playElement());
    },

    /* перемотка в секундах */
    seek(sec){
      const d = duration();
      if (d <= 0) return;
      offset = Math.max(0, Math.min(d - 0.15, sec));
      if (paused){
        /* на паузе просто запоминаем место — звук не трогаем */
        return;
      }
      playBuffer().catch(()=>playElement());
    },

    /* Следующий режим по кругу: по порядку → случайно → одна и та же.
       Одна кнопка вместо трёх — меньше визуального шума. */
    cyclePlayMode(){
      const order = ['all', 'shuffle', 'one'];
      const i = order.indexOf(playMode);
      playMode = order[(i + 1) % order.length];

      /* Режим влияет только на то, что делать ПОСЛЕ трека.
         Сам трек перезапускать незачем: у живого источника
         достаточно переключить loop. Раньше здесь стоял
         playBuffer(), и каждое нажатие заново тянуло файл из сети —
         всё это время mode висел в 'loading', а start() молчал. */
      applyLoopMode();
      return playMode;
    },

    /* режим плейлиста: 'one' | 'all' | 'shuffle' */
    setPlayMode(m){
      if (m !== 'one' && m !== 'all' && m !== 'shuffle') return playMode;
      playMode = m;
      applyLoopMode();
      return playMode;
    },
    get playMode(){ return playMode; },

    /* индекс текущего трека в плейлисте и общее число */
    get trackIndex(){ return plIdx; },
    get trackCount(){ return playlist().length; },

    /* список треков для интерфейса */
    tracks(){ return playlist().map(t => ({ title:t.title, kind:t.kind })); },

    /* выбрать трек по индексу */
    selectTrack(i){
      const pl = playlist();
      if (i < 0 || i >= pl.length || i === plIdx) return current().title;
      plIdx = i;
      offset = 0;
      paused = false;
      if (fallbackEl){ fallbackEl._src = null; }
      notifyTitle();
      playBuffer().catch(()=>playElement());
      return current().title;
    },

    /* следующий / предыдущий вручную */
    nextTrack(){
      advance(true);
      return current().title;
    },
    prevTrack(){
      const pl = playlist();
      if (pl.length < 2) return current().title;
      /* если играем больше трёх секунд — сначала в начало трека */
      if (this.elapsed > 3){
        offset = 0;
        playBuffer().catch(()=>playElement());
        return current().title;
      }
      plIdx = (plIdx - 1 + pl.length) % pl.length;
      offset = 0;
      if (fallbackEl){ fallbackEl._src = null; }
      notifyTitle();
      playBuffer().catch(()=>playElement());
      return current().title;
    },

    onTitleChange(fn){ onTitle = fn; notifyTitle(); },

    /* готов ли звук играть прямо сейчас.
       false — браузер ещё ждёт жеста пользователя. */
    get ready(){ return ctxReady; },

    /* подписка на пробуждение контекста: UI показывает подсказку,
       пока звук заблокирован, и убирает её после первого жеста */
    onUnlock(fn){ onUnlock = fn; fn(ctxReady); },

    /* разбудить контекст и, если надо, запустить воспроизведение.
       Вызывается из ЛЮБОГО жеста — клик по пустому месту тоже считается. */
    unlockNow(){
      const a = ctxOf();
      if (!a) return;
      watchState(a);

      /* resume() может отклониться, если жеста не было — это нормально */
      try { const r = a.resume(); if (r && r.catch) r.catch(()=>{}); } catch(e){}

      /* музыка была «запущена», но контекст спал — перезапускаем источник,
         чтобы он гарантированно пошёл с текущей позиции */
      if (want && !a._restarted){
        a._restarted = true;
        if (!srcNode || !live) this.restart();
      }
    },
    title(){ return current().title; },

    /* инфо о плейлисте — пригодится и для отладки */
    playlistSize(){ return playlist().length; },
    isLoop(){ return playlist().length === 1; },

    /* включить/выключить эхо помещения */
    setReverb(on){
      wantVerb = !!on;
      applyVerb(false);
    },
    get reverb(){ return wantVerb; },
    getVolume(){ return vol; },
    /* 0..1 — реальная громкость на выходе прямо сейчас */
    /* Уровень для эквалайзера. Считаем музыку звучащей, если есть
       живой источник или идёт воспроизведение. Флаг live трогать
       нельзя: он гаснет по событию statechange асинхронно и раньше
       гасил полоски при полностью играющей музыке. */
    get level(){ return (want && !paused) ? eff() : 0; },
    get playing(){ return live; },
    get mode(){ return mode; },
    get failed(){ return mode === 'error'; },

    spectrum(bands){
      const out = new Array(bands).fill(0);
      /* громкость ноль — отдаём тишину, не тревожа анализатор */
      if (eff() <= 0.0001) return out;

      /* Проверяем только наличие анализатора. Флаг live ненадёжен:
         он сбрасывается по событию statechange, и полоски замирали,
         хотя музыка играла. Данные всё равно читаются с живого узла. */
      if (!analyser || !buf) return out;
      try { analyser.getByteFrequencyData(buf); } catch(e){ return out; }

      const n = buf.length;
      const lo = 2, hi = Math.floor(n * 0.72);
      for (let b = 0; b < bands; b++){
        const t0 = b / bands, t1 = (b + 1) / bands;
        const i0 = Math.floor(lo * Math.pow(hi/lo, t0));
        const i1 = Math.max(i0 + 1, Math.floor(lo * Math.pow(hi/lo, t1)));
        let sum = 0, cnt = 0;
        for (let k = i0; k <= i1 && k < n; k++){ sum += buf[k]; cnt++; }
        out[b] = cnt ? (sum / cnt) / 255 : 0;
      }
      return out;
    }
  };
})();

/* ===========================================================================
   МИНИ-ЭКВАЛАЙЗЕР В ЛОББИ.
   Маленький канвас рядом с названием трека. Растёт прямо из спектра
   реального звука, поэтому пляшет именно под текущую музыку.
   ========================================================================== */
/* ===========================================================================
   ЭКВАЛАЙЗЕР.
   Сорок восемь полос — детальнее, чем было. Низы усилены: они дают
   самый заметный «толчок». Считается по сигналу ПОСЛЕ регулятора
   громкости, поэтому на нуле полоски замирают совсем.
   ========================================================================== */
/* МАЛО ПОЛОС — ТОЛСТЫЕ СТОЛБИКИ.
   На 48 полосах при ширине 120px каждая занимала ~2px: получалась
   рябь, в которой ничего не разглядеть. 16 полос дают по 7px —
   каждый столбик читается отдельно. */
const EQ_BANDS = 16;
let eqSmooth = new Array(EQ_BANDS).fill(0);

/* вес полосы: 0 — самый низ, 1 — самый верх.
   На низах до 3.1x, к верхам сходит к 1.0 */
function bandWeight(i){
  const t = i / (EQ_BANDS - 1);
  /* Бас выше верхов — так устроена настоящая музыка: низких частот
     объективно больше. Но раньше множитель был 2.4x поверх уже громкого
     баса, и картинка превращалась в ровную наклонную лестницу —
     двигались 3 полосы из 16. 1.35x даёт заметный бас без перекоса. */
  return 1 + 0.35 * Math.pow(1 - t, 2);
}

/* рисует готовый сглаженный спектр в канвас по id */
function drawEqInto(id, spec, t){
  const cvs = document.getElementById(id);
  if (!cvs) return;
  const cx = cvs.getContext('2d');
  if (!cx) return;

  const w = cvs.width, h = cvs.height;

  cx.setTransform(1,0,0,1,0,0);
  cx.clearRect(0, 0, w, h);

  const bw  = w / EQ_BANDS;
  /* зазор от ширины полосы: при 320px полоса 20px, зазор 3px, столбик 17px */
  const gap = Math.max(2, Math.round(bw * 0.15));
  const bwid = Math.max(3, bw - gap);

  /* ── состояние покоя ──
     Вместо пустоты — ряд тусклых чёрточек у самого низа. */
  let energy = 0;
  for (let i = 0; i < EQ_BANDS; i++) energy += spec[i];

  if (energy < 0.03){
    for (let i = 0; i < EQ_BANDS; i++){
      const hue = (i * 22 + t * 20) % 360;
      cx.fillStyle = `hsla(${hue},70%,45%,.45)`;
      cx.fillRect(i * bw + gap/2, h - h*0.14, bwid, Math.max(4, h*0.09));
    }
    cx.fillStyle = 'rgba(255,255,255,.10)';
    cx.fillRect(0, h-1, w, 1);
    return;
  }

  for (let i = 0; i < EQ_BANDS; i++){
    const v = spec[i];

    /* тихая полоса тоже даёт видимую черту */
    const hgt = Math.max(h*0.09, v * (h - 5));
    const hue = (i * 22 + t * 55) % 360;
    const x = i * bw + gap/2;
    const y = h - 1 - hgt;

    cx.fillStyle = v <= 0.008
      ? `hsla(${hue},75%,45%,.42)`      /* тихая — приглушённая */
      : `hsla(${hue},100%,60%,1)`;
    cx.fillRect(x, y, bwid, hgt);

    /* яркая макушка */
    if (v > 0.02 && hgt > 5){
      cx.fillStyle = `hsla(${hue},100%,92%,1)`;
      cx.fillRect(x, y, bwid, Math.max(h*0.05, hgt*0.22));
    }
  }

  cx.fillStyle = 'rgba(255,255,255,.10)';
  cx.fillRect(0, h-1, w, 1);
}

function drawSpectrum(){
  const t = performance.now()/1000;

  /* громкость в ноль — гасим мгновенно, без плавного хвоста */
  if (Music.level <= 0.0001){
    for (let i = 0; i < EQ_BANDS; i++) eqSmooth[i] = 0;
    drawEqInto('eqMini',  eqSmooth, t);
    drawEqInto('eqMini2', eqSmooth, t);
    return;
  }

  const raw = Music.spectrum(EQ_BANDS);

  /* ─────────── РАСЧЁТ ВЫСОТЫ ───────────
     РАНЬШЕ здесь было деление на пик: norm = 0.94 / peak, каждый кадр.
     Из-за этого самая громкая полоса ВСЕГДА прижималась к потолку —
     и на 100%, и на 50%, и на 25% громкости картинка была одинаковой.
     Удар бочки не поднимал бас, а опускал всё остальное: подскок +0 пп.
     Именно поэтому на полной громкости левая часть «заливалась».

     ТЕПЕРЬ никакой подгонки под пик. Фиксированное усиление и потолок
     0.97: на полной громкости бас стоит около 77% и у него остаётся
     запас, чтобы подскочить на ударе бочки. */
  const GAIN = 0.62;
  const CEIL = 0.97;

  for (let i = 0; i < EQ_BANDS; i++){
    const shaped = Math.pow(raw[i], 0.75) * bandWeight(i) * GAIN;
    const target = Math.min(CEIL, shaped);

    /* вверх — резко, вниз — плавно */
    eqSmooth[i] += (target - eqSmooth[i]) * (target > eqSmooth[i] ? 0.60 : 0.15);
  }

  drawEqInto('eqMini',  eqSmooth, t);
  drawEqInto('eqMini2', eqSmooth, t);
}

/* =============================================================== ПРЕДМЕТЫ ==/* =============================================================== ПРЕДМЕТЫ ==
