/* СФЕРА ДУШИ — всегда синяя, на любой карте.
   Раньше в градиенте был белый центр, а рисовалась сфера в режиме 'lighter':
   на светлом фоне «Страны чудес» это складывалось в белое пятно.
   Теперь заливка — плотный синий без белого, с тёмной обводкой,
   чтобы читалась и на радуге, и на тёмном кирпиче. */
function sprSoul(){
  const c = mkCanvas(TILE,TILE), g = c.getContext('2d');
  const CX = 16, CY = 15, R = 11;

  /* тёмный контур — держит форму на светлом фоне */
  g.fillStyle = '#08183f';
  g.beginPath(); g.arc(CX, CY, R+1.4, 0, 7); g.fill();

  /* тело: от светлого синего к глубокому */
  const grd = g.createRadialGradient(CX-3, CY-4, 1, CX, CY, R);
  grd.addColorStop(0,   '#7fc4ff');   /* блик — голубой, не белый */
  grd.addColorStop(0.35,'#3d8ef0');
  grd.addColorStop(0.72,'#1e5bc8');
  grd.addColorStop(1,   '#0a2f7a');
  g.fillStyle = grd;
  g.beginPath(); g.arc(CX, CY, R, 0, 7); g.fill();

  /* внутреннее кольцо */
  g.strokeStyle = 'rgba(140,200,255,.55)';
  g.lineWidth = 1;
  g.beginPath(); g.arc(CX, CY, R*0.72, 0, 7); g.stroke();

  /* маленький блик сверху слева */
  g.fillStyle = 'rgba(190,225,255,.75)';
  g.beginPath(); g.ellipse(CX-3.5, CY-4.5, 3, 2.2, -0.5, 0, 7); g.fill();

  return c;
}
/* бочка — простое препятствие */
function sprBarrel(){
  /* ПРЕПЯТСТВИЕ — простой чёрный блок. Никаких взрывов и урона,
     это стена, которую надо обходить. Радужную кайму рисует
     drawRainbowEdges вместе с обычными стенами. */
  const c = mkCanvas(TILE,TILE), g = c.getContext('2d');

  g.fillStyle = '#040406';
  g.fillRect(2, 2, TILE-4, TILE-4);

  g.strokeStyle = 'rgba(255,255,255,.07)';
  g.lineWidth = 1;
  g.strokeRect(3.5, 3.5, TILE-7, TILE-7);

  g.fillStyle = 'rgba(255,255,255,.045)';
  g.fillRect(5, 5, TILE-10, 1);
  g.fillRect(5, 5, 1, TILE-10);
  return c;
}

const SPR = { medkit:sprMedkit(), ammo:sprAmmo(), soul:sprSoul(), barrel:sprBarrel() };

/* ================================================================ ЗВУКИ ===
   Всё синтезируется на месте через WebAudio: укус, взрыв, смерть, поворот.
   ========================================================================== */
const Snd = (() => {
  let ac = null, on = true, master = 0.70;   /* общая громкость эффектов */
  function ctx(){
    if (!ac){
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return null;
      ac = new AC();
    }
    /* resume() отклоняется, если жеста ещё не было.
       Без catch это даёт необработанную ошибку в консоли. */
    if (ac.state === 'suspended'){
      try { const r = ac.resume(); if (r && r.catch) r.catch(()=>{}); } catch(e){}
    }
    return ac;
  }
  function tone(f0, f1, dur, type, vol, dly){
    if (!on) return; const a = ctx(); if (!a) return;
    const t0 = a.currentTime + (dly||0);
    const o = a.createOscillator(), gn = a.createGain();
    o.type = type || 'square';
    o.frequency.setValueAtTime(f0, t0);
    o.frequency.exponentialRampToValueAtTime(Math.max(20,f1), t0+dur);
    gn.gain.setValueAtTime(0, t0);
    gn.gain.linearRampToValueAtTime((vol==null?.18:vol) * master, t0+0.008);
    gn.gain.exponentialRampToValueAtTime(0.0001, t0+dur);
    o.connect(gn); gn.connect(a.destination);
    o.start(t0); o.stop(t0+dur+0.02);
  }
  function noise(dur, vol, filt, sweep){
    if (!on) return; const a = ctx(); if (!a) return;
    const len = Math.max(1, (a.sampleRate*dur)|0);
    const buf = a.createBuffer(1, len, a.sampleRate);
    const d = buf.getChannelData(0);
    for (let i=0;i<len;i++){
      const t = i/len;
      d[i] = (Math.random()*2-1) * Math.pow(1-t, 1.6);
    }
    const src = a.createBufferSource(); src.buffer = buf;
    const bq = a.createBiquadFilter(); bq.type='lowpass';
    bq.frequency.setValueAtTime(filt||1400, a.currentTime);
    if (sweep) bq.frequency.exponentialRampToValueAtTime(Math.max(60,filt*0.15), a.currentTime+dur);
    const gn = a.createGain(); gn.gain.value = (vol==null?.25:vol) * master;
    src.connect(bq); bq.connect(gn); gn.connect(a.destination);
    src.start();
  }
  return {
    bite(){ tone(520, 180, .09, 'square', .16); tone(760, 300, .06, 'sawtooth', .09, .01); },
    barrel(){ noise(.5, .4, 900, true); tone(150, 30, .55, 'sawtooth', .28); tone(90,24,.6,'square',.2,.03); },
    dead(){ tone(300, 40, .8, 'sawtooth', .25); tone(180, 30, .9, 'square', .18, .06);
            noise(.45,.3,700,true); },
    turn(){ tone(1200, 900, .032, 'square', .05); },
    shoot(){ tone(880, 170, .11, 'square', .20); noise(.10, .16, 2200, true);
             tone(300, 90, .14, 'sawtooth', .12, .02); },
    jam(){ tone(200, 120, .10, 'square', .12); },
    pick(){ tone(660, 990, .07, 'square', .13); tone(990, 1320, .07, 'square', .1, .06); },
    hurt(){ tone(220, 90, .22, 'sawtooth', .22); noise(.18,.2,600,true); },
    level(){ [523,659,784,1046].forEach((f,i)=>tone(f,f*1.5,.16,'square',.13,i*.09)); },
    hungry(n){ /* урчит: чем ближе смерть, тем ниже нотa и чаще повтор */
      const f = 150 - n*70, v = .06 + n*.10;
      tone(f, f*0.62, .28, 'sawtooth', v);
      tone(f*1.5, f*0.9, .22, 'square', v*.5, .04);
      noise(.14, v*.4, 420, true);
    },
    toggle(v){ on = v; if (on) ctx(); return on; },
    setOn(v){ on = !!v; if (on) ctx(); },
    setVolume(v){ master = clamp(v, 0, 1); },
    getVolume(){ return master; },
    get on(){ return on; },
    unlock(){ ctx(); }
  };
})();


/* ================================================================ СЕТКА == */
const grid = new Uint8Array(COLS*ROWS);
const inB  = (cx,cy) => cx>=0 && cy>=0 && cx<COLS && cy<ROWS;
const at   = (cx,cy) => inB(cx,cy) ? grid[cy*COLS+cx] : BRICK;   // вне карты = стена
const isWall = (cx,cy) => at(cx,cy) !== FLOOR;

/* ---------------------------------------------------- пререндер арены --- */
const arena = document.createElement('canvas');
arena.width = ARENA_W; arena.height = ARENA_H;
const aCtx = arena.getContext('2d');
aCtx.imageSmoothingEnabled = false;

/* радужный цвет по фазе 0..1 */
function rainbowAt(phase, alpha){
  const h = ((phase % 1) + 1) % 1 * 360;
  return `hsla(${h},100%,60%,${alpha == null ? 1 : alpha})`;
}

function paintArena(){
  aCtx.fillStyle = '#000000';
  aCtx.fillRect(0,0,ARENA_W,ARENA_H);

  for (let y=0;y<ROWS;y++) for (let x=0;x<COLS;x++){
    const t = grid[y*COLS+x];
    const px = x*TILE, py = y*TILE;
    if (t === FLOOR){
      aCtx.drawImage(((x+y)&1) ? TXT.floorA : TXT.floorB, px, py);
    } else if (t === BRICK){
      aCtx.drawImage(TXT.brick, px, py);
    } else if (t === TECH){
      aCtx.drawImage(TXT.tech, px, py);
    }
  }
}

/* ---------------------------------------------------------------------------
   РАДУЖНАЯ КАЙМА НА СТЕНАХ.
   Рисуется не в статичную текстуру, а каждый кадр поверх арены — поэтому
   цвет бежит по периметру. Грани выводятся только там, где сосед — пол:
   внутренние стыки между блоками не светятся, получается чёткий контур.
   --------------------------------------------------------------------------- */
function drawRainbowEdges(t){
  const phase = t * 0.16;          /* скорость перелива */
  const TH = 3;                    /* толщина линии */

  /* проходим по всем клеткам-стенам */
  for (let y=0;y<ROWS;y++){
    for (let x=0;x<COLS;x++){
      const isBarrel = G.barrels.some(b => b.x===x && b.y===y);
      if (grid[y*COLS+x] === FLOOR && !isBarrel) continue;

      const px = x*TILE, py = y*TILE;

      /* фаза зависит от позиции: перелив идёт по диагонали */
      const ph = phase + (x + y) * 0.035;

      const up    = (y === 0)        || grid[(y-1)*COLS + x] === FLOOR;
      const down  = (y === ROWS-1)   || grid[(y+1)*COLS + x] === FLOOR;
      const left  = (x === 0)        || grid[y*COLS + (x-1)] === FLOOR;
      const right = (x === COLS-1)   || grid[y*COLS + (x+1)] === FLOOR;

      /* верхняя грань */
      if (up){
        const gr = g2.createLinearGradient(px, py, px+TILE, py);
        gr.addColorStop(0, rainbowAt(ph));
        gr.addColorStop(1, rainbowAt(ph + 0.08));
        g2.fillStyle = gr;
        g2.fillRect(px, py, TILE, TH);
      }
      /* нижняя */
      if (down){
        const gr = g2.createLinearGradient(px, py+TILE, px+TILE, py+TILE);
        gr.addColorStop(0, rainbowAt(ph + 0.5));
        gr.addColorStop(1, rainbowAt(ph + 0.58));
        g2.fillStyle = gr;
        g2.fillRect(px, py+TILE-TH, TILE, TH);
      }
      /* левая */
      if (left){
        const gr = g2.createLinearGradient(px, py, px, py+TILE);
        gr.addColorStop(0, rainbowAt(ph + 0.25));
        gr.addColorStop(1, rainbowAt(ph + 0.33));
        g2.fillStyle = gr;
        g2.fillRect(px, py, TH, TILE);
      }
      /* правая */
      if (right){
        const gr = g2.createLinearGradient(px+TILE, py, px+TILE, py+TILE);
        gr.addColorStop(0, rainbowAt(ph + 0.75));
        gr.addColorStop(1, rainbowAt(ph + 0.83));
        g2.fillStyle = gr;
        g2.fillRect(px+TILE-TH, py, TH, TILE);
      }
    }
  }
}

function buildArena(){
  grid.fill(FLOOR);
  for (let x=0;x<COLS;x++){ grid[x]=BRICK; grid[(ROWS-1)*COLS+x]=BRICK; }
  for (let y=0;y<ROWS;y++){ grid[y*COLS]=BRICK; grid[y*COLS+COLS-1]=BRICK; }
  paintArena();
}

/* ---------------------------------------------------------------------------
   Арена начинается пустой. Дальше она обрастает сама: раз в минуту падаетт
   этап — новые глыбы, блоки и (с третьей минуты) Враги.
   --------------------------------------------------------------------------- */

/* сколько свободных клеток достижимо из точки — проверка, что арену не замуровало */
function floodCount(sx, sy){
  if (isWall(sx,sy)) return 0;
  const seen = new Uint8Array(COLS*ROWS);
  const stack = [sy*COLS + sx];
  seen[sy*COLS + sx] = 1;
  let n = 0;
  while (stack.length){
    const idx = stack.pop(); n++;
    const x = idx % COLS, y = (idx/COLS)|0;
    const nb = [[x+1,y],[x-1,y],[x,y+1],[x,y-1]];
    for (let k=0;k<4;k++){
      const nx = nb[k][0], ny = nb[k][1];
      if (!inB(nx,ny)) continue;
      const i2 = ny*COLS + nx;
      if (seen[i2] || grid[i2] !== FLOOR) continue;
      seen[i2] = 1;
      stack.push(i2);
    }
  }
  return n;
}

function countFree(){
  let n = 0;
  for (let i=0;i<grid.length;i++) if (grid[i] === FLOOR) n++;
  return n;
}

/* прилепить глыбу. Не влезает или задевает змейку — отступаем и пробуем снова */
function addBlock(){
  const sizes = [[1,1],[1,1],[2,1],[1,2],[2,2],[3,1]];
  for (let attempt = 0; attempt < 80; attempt++){
    const sz = pick(sizes), bw = sz[0], bh = sz[1];
    const bx = 2 + rnd(COLS - 4 - bw);
    const by = 2 + rnd(ROWS - 4 - bh);

    let ok = true;
    for (let j = -1; j <= bh && ok; j++){
      for (let i = -1; i <= bw && ok; i++){
        const cx = bx + i, cy = by + j;
        if (!inB(cx,cy)) { ok = false; break; }
        if (at(cx,cy) !== FLOOR) { ok = false; break; }
        if (occ(cx,cy)) { ok = false; break; }
      }
    }
    if (!ok) continue;

    const h = G.snake[0];
    if (h && (Math.abs(h.x - bx) + Math.abs(h.y - by)) < 3) continue;

    /* запоминаем клетки, чтобы откатить, если замуруем арену */
    const written = [];
    for (let j = 0; j < bh; j++)
      for (let i = 0; i < bw; i++){
        const idx = (by+j)*COLS + bx+i;
        written.push(idx);
        grid[idx] = (rnd(6) === 0) ? TECH : BRICK;
      }

    /* этап не имеет права отрезать змейку от большей части арены */
    if (h){
      const reach = floodCount(h.x, h.y);
      const total = countFree();
      if (reach < total * 0.55){
        for (const idx of written) grid[idx] = FLOOR;
        continue;                      // блок не годится, пробуем другой
      }
    }

    if (rnd(3) === 0){
      const spot = freeCellAround(bx, by, bw, bh);
      if (spot) addBarrel(spot.x, spot.y);
    }
    return true;
  }
  return false;
}

/* свободная клетка вплотную к свежей глыбе — туда ставим бочку */
function freeCellAround(bx, by, bw, bh){
  for (let k = 0; k < 40; k++){
    const side = rnd(4);
    let cx, cy;
    if (side === 0){ cx = bx + rnd(bw); cy = by - 1; }
    else if (side === 1){ cx = bx + rnd(bw); cy = by + bh; }
    else if (side === 2){ cx = bx - 1; cy = by + rnd(bh); }
    else { cx = bx + bw; cy = by + rnd(bh); }
    if (!inB(cx,cy)) continue;
    if (at(cx,cy) !== FLOOR) continue;
    if (occ(cx,cy)) continue;
    return {x:cx, y:cy};
  }
  return null;
}

/* этап усложнения */
function escalate(){
  G.level++;
  const lvl = G.level;
  const m = MODES[G.modeIdx];

  const wantBlocks = Math.min(9, m.blocks + Math.floor(lvl/2));
  let placed = 0;
  for (let i = 0; i < wantBlocks; i++) if (addBlock()) placed++;

  /* бочки копятся, но до предела — иначе арена превращается в кашу */
  const wantBarrels = Math.min(10, m.barrels + Math.floor(lvl/2));
  let bplaced = 0;
  for (let i = 0; i < wantBarrels; i++){
    const c = freeCell(5);
    if (c && addBarrel(c.x, c.y)) bplaced++;
  }
  let hplaced = 0;

  /* Враги: сколько влезет до потолка сложности */
  if (lvl >= m.huntersFrom){
    for (let k = 0; k < m.huntAdd; k++){
      if (G.hunters.length >= m.huntCap) break;
      const c = freeCell(9);
      if (!c) break;
      G.hunters.push({
        x:c.x, y:c.y, t:0, moveT:0,
        speed: m.huntSpeed + lvl * 0.04
      });
      hplaced++;
    }
  }

  paintArena();
  Snd.level();
  announce('ЭТАП ' + lvl + ' — АРЕНА МЕНЯЕТСЯ', '#ff8a3c', 2.6);
  G.log = 'этап ' + lvl + ': +' + placed + ' глыб, +' + bplaced + ' блоков' +
          (hplaced ? ', +' + hplaced + ' Врагов' : '');
}

