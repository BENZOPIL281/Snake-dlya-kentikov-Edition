/* постепенное появление: одно за раз, с паузой из режима */
/* ---------------------------------------------------------------------------
   ПОЯВЛЕНИЕ ПРЕДМЕТОВ.

   Синяя сфера — ЕДИНСТВЕННЫЙ источник роста длины и на арене она ВСЕГДА одна:
   забрали — через soulDelay появилась следующая.
   Аптечки и патроны длину не растят вообще, живут по таймеру и с потолком.
   --------------------------------------------------------------------------- */
/* ============================================================== ГОЛОД ==
   Сфера — единственный источник роста, но теперь она ещё и еда.
   Не съел за HUNGER_MAX секунд — умер. Таймер не крутится, пока змейка
   стоит до первого нажатия, и обнуляется на каждой съеденной сфере.
   ---------------------------------------------------------------------- */
function updateHunger(dt){
  G.hunger -= dt;

  /* урчание в животе: сначала тихо и редко, к финалу — часто и низко.
     Звук идёт «толчками», а не каждый кадр, иначе сливается в сплошной вой. */
  const left = Math.max(0, G.hunger);
  const f = clamp(left / HUNGER_MAX, 0, 1);        /* 1 — сыт, 0 — край */

  if (left <= 12){
    G.hungerWarn -= dt;
    if (G.hungerWarn <= 0){
      Snd.hungry(1 - f);                            /* 0..1, насколько голоден */
      G.hungerWarn = 0.55 + f * 1.9;                /* чем ближе смерть, тем чаще */
    }
  } else {
    G.hungerWarn = 0;
  }

  if (G.hunger <= 0){
    G.hunger = 0;
    die('hunger');
  }
}

function updatePickups(dt){
  const m = MODES[G.modeIdx];

  /* --- синяя сфера: ровно одна и появляется редко ---
     Именно она растит длину, поэтому пауза после каждого съеденного шара
     считается заново и не даёт змейке раздуться за полминуты.             */
  if (countType('soul') > 0){
    G.soulCd = m.soulDelay;
  } else {
    G.soulCd -= dt;
    if (G.soulCd <= 0)
      G.soulCd = spawnPickupType('soul') ? m.soulDelay : 1.0;
  }

  /* --- аптечки и патроны: редкий шанс ---
     аптечка выпадает с шансом 1 к 15, патрон — 1 к 20. Проверка идёт раз в
     m.pickCd секунд, поэтому на деле предметы сыплются в среднем раз в 20-40
     секунд, а не горстями, как было в первой версии.                        */
  G.pickupCd -= dt;
  if (G.pickupCd > 0) return;
  G.pickupCd = m.pickCd;

  if (countType('med')  < m.medCap  && Math.random() < 1/ROLL_MED ) spawnPickupType('med');
  if (countType('ammo') < m.ammoCap && Math.random() < 1/ROLL_AMMO) spawnPickupType('ammo');
}

