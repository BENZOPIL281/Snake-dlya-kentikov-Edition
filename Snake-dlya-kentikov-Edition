<script>
"use strict";
/* ==========================================================================
   ЗМЕЙКА ДЛЯ КЕНТИКОВ · Edition (бета)
   Оригинальная игра. Вся графика рисуется процедурно на canvas,
   все звуки синтезируются через WebAudio — ни одного внешнего файла,
   кроме твоего трека в лобби.
   ========================================================================== */


/* ------------------------------------------------------------------ сетка */
const TILE = 32, COLS = 36, ROWS = 24;   /* арена 1152 x 768 */
const ARENA_W = COLS*TILE, ARENA_H = ROWS*TILE;   // 960 x 640
const HUD_H = 120;
/* Голод: если не съесть сферу за это время — смерть. 30 секунд названо в задаче,
