  g2.fillRect(0, y0, W, HUD_H);
  /* нарощенные «металлические» плашки */
  g2.fillStyle = '#1a1210';
  g2.fillRect(0, y0, W, 3);
  g2.fillStyle = '#3a2418';
  g2.fillRect(0, y0+3, W, 2);

  /* СЕРДЦА: белые значки, пустые — контуром */
  g2.font = 'bold 12px "Courier New",monospace';
  g2.fillStyle = '#c9a06a';
  g2.fillText('СЕРДЦА', 16, y0+16);

  /* Сердец всего три, поэтому каждое можно сделать крупнее —
     видно с одного взгляда, не приходится считать мелочь. */
  for (let i = 0; i < MAX_HEARTS; i++){
    const hx = 26 + i * 46;
    const hy = y0 + 44;
    const full = i < G.hp;

    /* потерянное сердце еле тлеет, чтобы было видно, сколько осталось */
    drawHeart(hx, hy, 16,
      full ? '#ffffff' : 'rgba(255,255,255,.07)',
      full ? '#ffffff' : 'rgba(255,255,255,.30)');

    if (full){
      g2.save();
      g2.shadowColor = '#ffffff';
      g2.shadowBlur = 14;
      heartPath(g2, hx, hy, 16);
      g2.strokeStyle = 'rgba(255,255,255,.85)';
      g2.lineWidth = 1.5;
      g2.stroke();
      g2.restore();
    }
  }

  g2.textAlign = 'left';

  /* ПАТРОНЫ + перезарядка */
  g2.font = 'bold 13px "Courier New",monospace';
  g2.fillStyle = '#c9a06a';
  g2.fillText('ЭНЕРГИЯ', 218, y0+28);
  g2.font = 'bold 26px "Courier New",monospace';
  g2.fillStyle = G.ammo > 0 ? '#ffcf3c' : '#7a4a2a';
  g2.fillText(String(G.ammo), 218, y0+55);
  const w = 72;
  if (G.shootCd > 0){
    g2.fillStyle = '#2a1a10'; g2.fillRect(218, y0+61, w, 5);
    g2.fillStyle = '#ff8a3c';
    g2.fillRect(218, y0+61, w * clamp(1 - G.shootCd/2.0, 0, 1), 5);
  } else {
    g2.fillStyle = '#3f6b1e';
    g2.font = 'bold 10px "Courier New",monospace';
    g2.fillText('ГОТОВ', 218, y0+66);
  }

  /* ОЧКИ */
  g2.font = 'bold 13px "Courier New",monospace';
  g2.fillStyle = '#c9a06a'; g2.fillText('ОЧКИ', 322, y0+28);
  g2.font = 'bold 26px "Courier New",monospace';
  g2.fillStyle = '#ffcf3c';
  g2.shadowColor = '#ffcf3c'; g2.shadowBlur = 10;
  g2.fillText(String(G.score), 322, y0+55);
  g2.shadowBlur = 0;

  /* ДЛИНА */
  g2.font = 'bold 13px "Courier New",monospace';
  g2.fillStyle = '#c9a06a'; g2.fillText('ДЛИНА', 436, y0+28);
  g2.font = 'bold 26px "Courier New",monospace';
  g2.fillStyle = '#8fe25c';
  g2.fillText(String(G.snake.length), 436, y0+55);

  /* ЭТАП */
  g2.font = 'bold 13px "Courier New",monospace';
  g2.fillStyle = '#c9a06a'; g2.fillText('ЭТАП', 540, y0+28);
  g2.font = 'bold 26px "Courier New",monospace';
  g2.fillStyle = '#ff8a3c';
  g2.fillText(String(Math.max(1, G.level)), 540, y0+55);

  /* ДО ЭТАПА */
  g2.font = 'bold 13px "Courier New",monospace';
  g2.fillStyle = '#c9a06a'; g2.fillText('ДО ЭТАПА', 618, y0+28);
  const secs = Math.max(0, Math.ceil(G.escT));
  g2.font = 'bold 26px "Courier New",monospace';
  g2.fillStyle = secs <= 8 ? '#ff3b18' : '#c2d86a';
  g2.fillText(secs + 'с', 618, y0+55);

  /* ПОРЧА: показываем НАЗВАНИЕ события и что оно сделало.
     Раньше строка резалась посимвольно и часть букв пропареныла —
     теперь текст вписывается в свою колонку по реальной ширине. */
  g2.font = 'bold 13px "Courier New",monospace';
  g2.fillStyle = '#c9a06a'; g2.fillText('СОБЫТИЕ', 722, y0+26);

  const colX  = 722;
  const colW  = W - colX - 16;              /* сколько реально влезает */

  g2.font = 'bold 15px "Courier New",monospace';
  g2.fillStyle = '#c06cff';
  const cname = G.corrName || 'тихо';
  g2.fillText(fitText(cname, colW), colX, y0+46);

  if (G.corrDesc){
    g2.font = '12px "Courier New",monospace';
    g2.fillStyle = '#8a6cb0';
    g2.fillText(fitText(G.corrDesc, colW), colX, y0+64);
  }

  /* СЛОЖНОСТЬ — с пояснением, иначе висит просто название */
  /* MODES[G.modeIdx] может оказаться пустым, если индекс побился.
     Берём первый режим как запасной: лучше показать неверную
     подпись, чем уронить весь кадр и оставить игрока с мёртвым
     экраном. */
  const md = MODES[G.modeIdx] || MODES[0];
  g2.font = 'bold 12px "Courier New",monospace';
  g2.fillStyle = '#c9a06a';
  g2.fillText('сложность:', colX, y0+84);
  g2.fillStyle = md.col;
  g2.fillText(fitText(md.name, colW), colX, y0+98);

  /* ── ГОЛОД: полоса под счётчиком этапа. Краснеет и мигает к концу ── */
  {
    const bx = 618, by = y0+70, bw = 168, bh = 9;
    const frac = clamp(G.hunger / HUNGER_MAX, 0, 1);
    const low  = G.hunger <= 10;
    const crit = G.hunger <= 5;

    g2.font = 'bold 12px "Courier New",monospace';
    g2.textAlign = 'left';
    g2.fillStyle = low ? '#ff8a3c' : '#c9a06a';
    g2.fillText('СЫТОСТЬ', bx, by - 4);

    g2.fillStyle = '#160d0a'; g2.fillRect(bx, by, bw, bh);

    /* мигание на последних секундах — предупреждение видно боковым зрением */
    const show = crit ? (Math.floor(performance.now()/140) % 2 === 0) : true;

    if (show){
      const colA = crit ? '#ff2a10' : low ? '#ff8a3c' : '#7cf0ff';
      const colB = crit ? '#ff8a3c' : low ? '#ffcf3c' : '#c2f4ff';
      const grd = g2.createLinearGradient(bx, by, bx, by+bh);
      grd.addColorStop(0, colB); grd.addColorStop(1, colA);
      g2.fillStyle = grd;
      g2.fillRect(bx+1, by+1, Math.max(0, (bw-2)*frac), bh-2);

      if (low){
        g2.save();
        g2.shadowColor = colA; g2.shadowBlur = 12;
        g2.fillRect(bx+1, by+1, Math.max(0, (bw-2)*frac), bh-2);
        g2.restore();
      }
    }

    g2.strokeStyle = low ? 'rgba(255,138,60,.75)' : '#3a2c1c';
    g2.lineWidth = 1.5;
    g2.strokeRect(bx+.5, by+.5, bw-1, bh-1);

    /* секунды справа от полосы */
    g2.font = 'bold 11px "Courier New",monospace';
    g2.textAlign = 'right';
    g2.fillStyle = crit ? '#ff2a10' : low ? '#ff8a3c' : '#6b5a48';
    g2.fillText(Math.ceil(G.hunger) + 'с', bx + bw + 30, by + bh);
  }

  /* активные эффекты */
  g2.textAlign = 'right';
  const eff = [];
  if (G.speedMul > 1 && G.tempT > 0) eff.push('ЯРОСТЬ ' + G.tempT.toFixed(0) + 'с');
  if (G.speedMul < 1 && G.tempT > 0) eff.push('ТИШИНА ' + G.tempT.toFixed(0) + 'с');
  if (G.flicker > 0) eff.push('СВЕТ ' + G.flicker.toFixed(0) + 'с');
  if (G.mirror > 0)  eff.push('ЗЕРКАЛО ' + G.mirror.toFixed(0) + 'с');
  if (G.spaghetti > 0) eff.push('СПАГЕТТИ ' + G.spaghetti.toFixed(0) + 'с');
  if (G.noise > 0)   eff.push('ПОМЕХИ ' + G.noise.toFixed(0) + 'с');
  if (G.dark > 0)    eff.push('ТЬМА ' + G.dark.toFixed(0) + 'с');
  if (G.double > 0)  eff.push('ДВОЕНИЕ ' + G.double.toFixed(0) + 'с');
  if (G.hunters.length) eff.push('ВРАГОВ ' + G.hunters.length);
  if (G.hunger <= 10) eff.push('ГОЛОДЕН');

  g2.font = 'bold 12px "Courier New",monospace';
  if (eff.length){
    g2.fillStyle = '#c06cff';
    g2.fillText(eff.join('  ·  '), W-16, y0+30);
  } else {
    g2.fillStyle = '#6b5a48';
    g2.font = '11px "Courier New",monospace';
    g2.fillText('ОТСТРЕЛ САМ   ·   ESC — пауза', W-16, y0+30);
  }
  g2.fillStyle = '#6b5a48';
  g2.font = '11px "Courier New",monospace';
  g2.fillText('событий пережито: ' + G.corrCount, W-16, y0+68);
  g2.textAlign = 'left';
}

/* ================================================================== ВВОД == */
function setDir(nx, ny){
  if (G.state !== 'play') return;
  G.armed = true;
  /* управление честное: ни один эффект не выворачивает ввод */
  if (nx === -G.dir.x && ny === -G.dir.y) return;
  const ref = G.queue.length ? G.queue[G.queue.length-1] : G.dir;
  if (nx === -ref.x && ny === -ref.y) return;   // 180° отбрасываем сразу
  if (nx === ref.x && ny === ref.y) return;
  if (G.queue.length > 2) return;
  G.queue.push({x:nx, y:ny});
}

addEventListener('keydown', e => {
  const k = e.key.toLowerCase();
  if (['arrowup','arrowdown','arrowleft','arrowright',' '].includes(k)) e.preventDefault();

  if (G.state === 'menu' || G.state === 'over'){
    if (k === 'enter' || k === ' '){ startRun(); }
    return;
  }
  if (G.state === 'pause'){
    if (k === 'escape' || k === 'enter'){ resume(); }
    return;
  }
  if (k === 'escape'){ pause(); return; }
  if (k === 'r' || k === 'к'){ startRun(); return; }   /* R и русская К */

  if (k === 'w' || k === 'arrowup'    || k === 'ц') setDir(0,-1);
  if (k === 's' || k === 'arrowdown'  || k === 'ы') setDir(0, 1);
  if (k === 'a' || k === 'arrowleft'  || k === 'ф') setDir(-1,0);
  if (k === 'd' || k === 'arrowright' || k === 'в') setDir( 1,0);
});

/* свайпы для телефона */
let touchStart = null;
cv.addEventListener('touchstart', e => {
  e.preventDefault();
  const t = e.changedTouches[0];
  touchStart = { x:t.clientX, y:t.clientY };
}, { passive:false });

cv.addEventListener('touchmove', e => e.preventDefault(), { passive:false });

cv.addEventListener('touchend', e => {
  e.preventDefault();
  if (!touchStart) return;
  const t = e.changedTouches[0];
  const dx = t.clientX - touchStart.x, dy = t.clientY - touchStart.y;
  touchStart = null;
  if (Math.hypot(dx,dy) < 22){
    if (G.state === 'menu' || G.state === 'over') startRun();
    return;
  }
  if (Math.abs(dx) > Math.abs(dy)) setDir(dx > 0 ? 1 : -1, 0);
  else                             setDir(0, dy > 0 ? 1 : -1);
}, { passive:false });

/* клик по канвасу — начать/продолжить */
cv.addEventListener('click', () => {
  if (G.state === 'menu' || G.state === 'over') startRun();
  else if (G.state === 'pause') resume();
});

/* =============================================================== ЭКРАНЫ == */
const el = id => document.getElementById(id);
const ovMenu = el('menu'), ovPause = el('pause'), ovOver = el('over');

function hideAll(){ ovMenu.classList.add('hide'); ovPause.classList.add('hide'); ovOver.classList.add('hide'); }

function showMenu(){
  hideAll(); ovMenu.classList.remove('hide');
  G.state = 'menu';
  Music.setReverb(false);
  refreshPlayer();
  /* start() сам поймёт, что трек уже играет, и продолжит с того же места */
  Music.start();
}

function pause(){
  if (G.state !== 'play') return;
  G.state = 'pause';
  hideAll(); ovPause.classList.remove('hide');
  Music.setReverb(false);     /* на паузе — обычный, сухой звук */
  refreshPlayer();            /* панель могла быть закрыта, пока играло */
}

function resume(){
  if (G.state !== 'pause') return;
  hideAll();
  G.state = 'play';
  Music.setReverb(true);
}

