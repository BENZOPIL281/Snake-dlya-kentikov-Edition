/* добавить бочку — единственный вход, поэтому лимит держится всегда */
function addBarrel(cx, cy){
  if (G.barrels.length >= BARREL_CAP) return false;
  if (at(cx,cy) !== FLOOR) return false;
  if (occ(cx,cy)) return false;
  G.barrels.push({x:cx, y:cy, fuse:0});
  return true;
}

/* свободна ли клетка от змейки и предметов */
function occ(cx,cy){
  for (const s of G.snake)   if (s.x===cx && s.y===cy) return true;
  for (const b of G.barrels) if (b.x===cx && b.y===cy) return true;
  for (const p of G.pickups) if (p.x===cx && p.y===cy) return true;
  for (const im of G.hunters) if (im.x===cx && im.y===cy) return true;
  return false;
}

