/* ============================================================== ПАРТИКЛЫ */
function burst(px, py, n, col, spd, life){
  for (let i=0;i<n;i++){
    const a = Math.random()*Math.PI*2, v = spd*(0.3+Math.random());
    G.particles.push({
      x:px, y:py, vx:Math.cos(a)*v, vy:Math.sin(a)*v,
      life: life*(0.6+Math.random()*0.7), max:life, col,
      r: 1.5 + Math.random()*3.5
    });
  }
}
function announce(text, col, dur){
  G.ann = { text, col, t:0, dur: dur||2.6 };
}

/* ================================================================ ЗВУКИ == */
function boom(px, py){
  Snd.barrel();
  burst(px, py, 46, '#ff8a3c', 190, .75);
  burst(px, py, 22, '#ffd23c', 130, .55);
  G.shake = Math.min(22, G.shake + 13);
  G.flash = .55; G.flashCol = '#ff8a3c';
}

/* ============================================================ УРОН/СМЕРТЬ */
function hurt(amount, cause){
  if (G.state !== 'play') return;
  G.hp = Math.max(0, G.hp - amount);
  Snd.hurt();
  G.shake = Math.min(18, G.shake + 7);
  G.flash = .38; G.flashCol = '#ff2020';
  if (G.hp <= 0){ die(cause); }
}

function die(cause){
  if (G.state === 'over') return;
  G.state = 'over';
  G.cause = cause;
  Snd.dead();
  const h = G.snake[0];
  if (h) burst(h.x*TILE+TILE/2, h.y*TILE+TILE/2, 70, '#ff3b18', 210, 1.0);
  if (h) burst(h.x*TILE+TILE/2, h.y*TILE+TILE/2, 40, '#c2d86a', 150, .8);
  G.shake = 26;
  Music.setReverb(false);
  showOver();
}

/* ================================================================ СПАВН == */
function freeCell(minDistFromHead){
  for (let k=0;k<400;k++){
    const cx = 1+rnd(COLS-2), cy = 1+rnd(ROWS-2);
    if (at(cx,cy) !== FLOOR) continue;
    if (occ(cx,cy)) continue;
    if (minDistFromHead){
      const h = G.snake[0];
      if (h && Math.abs(h.x-cx) + Math.abs(h.y-cy) < minDistFromHead) continue;
    }
    return {x:cx, y:cy};
  }
  return null;
}

function countType(t){
  let n = 0;
  for (const p of G.pickups) if (p.t === t) n++;
  return n;
}

/* поставить предмет конкретного типа; сферу — только если её ещё нет */
function spawnPickupType(t){
  if (t === 'soul' && countType('soul') > 0) return false;
  /* сердец на карте не больше двух — проверка на любом пути появления */
  if (t === 'med' && countType('med') >= 2) return false;
  const c = freeCell(4);
  if (!c) return false;
  G.pickups.push({x:c.x, y:c.y, t});
  return true;
}

function spawnPickup(){
  return spawnPickupType('soul');
}

