const HUNGER_MAX = 30;                                 // полоса статуса снизу:
                                                   // поднята с 80, чтобы
                                                   // нижние строки не срезались
const W = ARENA_W, H = ARENA_H + HUD_H;

const cv  = document.getElementById('game');
const g2  = cv.getContext('2d');
g2.imageSmoothingEnabled = false;

/* типы клеток */
