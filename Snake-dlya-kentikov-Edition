  hideAll();
  el('overTitle').textContent = pick(['ТЫ ВСЁ','КОНЕЦ ЗАБЕГА','ЗМЕЙКА ПАЛА','УВЫ']);
  el('scoreBig').textContent = G.score;
  /* сначала сухая причина, потом шутка — без перемешивания */
  el('taunt').textContent = G.cause
    ? (CAUSES[G.cause] || 'смерть: причина неизвестна') +
      '\n' + pick(TAUNTS[G.cause] || ['Ну, бывает.'])
    : 'смерть: просто лёг';
  /* какое событие было активно в момент смерти.
     G.corrAt — момент запуска, G.corrDur — сколько длится.
     Если событие закончилось раньше смерти, показывать его неправильно;
     события без длительности (бонус, завал стен) считаются мгновенными,
     поэтому для них условие «прошло < длительности» не применяем. */
  const since = G.time - G.corrAt;
  const liveNow = G.currCorr && (G.corrDur === 0 || since < G.corrDur)
                  && G.corrCount > 0;

  el('stats').innerHTML =
    'длина: <b style="color:#8fe25c">' + G.snake.length + '</b> &nbsp;·&nbsp; ' +
    'шагов: <b style="color:#c9a06a">' + G.steps + '</b> &nbsp;·&nbsp; ' +
    'прожито: <b style="color:#c9a06a">' + G.time.toFixed(1) + 'с</b><br>' +
    'Врагов убито: <b style="color:#ffffff">' + G.kills + '</b> &nbsp;·&nbsp; ' +
    'событий пережито: <b style="color:#c06cff">' + G.corrCount + '</b> &nbsp;·&nbsp; ' +
    'сложность: <b style="color:' + (MODES[G.modeIdx] || MODES[0]).col + '">' + (MODES[G.modeIdx] || MODES[0]).name + '</b><br>' +
    'умер во время: <b style="color:' + (liveNow ? G.corrCol : '#6a5a48') + '">' +
      (liveNow ? G.corrName : 'тишины') + '</b>';

  ovOver.classList.remove('hide');
}

