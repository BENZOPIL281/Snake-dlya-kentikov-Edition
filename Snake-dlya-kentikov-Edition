<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no,viewport-fit=cover">
<title>Змейка для кентиков Edition</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{width:100%;height:100%;overflow:hidden;background:#0a0507;
  font-family:"Courier New",ui-monospace,monospace;color:#e8dcc8;user-select:none}
#wrap{position:fixed;inset:0;display:flex;align-items:center;justify-content:center}
#game{display:block;max-width:100%;max-height:100%;
  width:auto;height:auto;
  image-rendering:pixelated;image-rendering:crisp-edges;
  box-shadow:0 0 60px rgba(140,20,20,.45),0 0 140px rgba(0,0,0,.9)}

/* ---------- оверлеи ---------- */
/* RGB-перелив лобби */
@keyframes rgbHue{ to{ filter:hue-rotate(360deg); } }
@keyframes rgbGlow{
  0%   { box-shadow:0 0 34px rgba(255,60,120,.5), inset 0 0 60px rgba(0,0,0,.75); }
  25%  { box-shadow:0 0 34px rgba(80,220,255,.5), inset 0 0 60px rgba(0,0,0,.75); }
  50%  { box-shadow:0 0 34px rgba(120,255,140,.5), inset 0 0 60px rgba(0,0,0,.75); }
  75%  { box-shadow:0 0 34px rgba(200,120,255,.5), inset 0 0 60px rgba(0,0,0,.75); }
  100% { box-shadow:0 0 34px rgba(255,60,120,.5), inset 0 0 60px rgba(0,0,0,.75); }
}
.ov{position:absolute;inset:0;z-index:10;display:flex;
  align-items:flex-start;            /* не center: при переполнении
                                        center обрезает и верх, и низ,
                                        а до низа не доскроллить */
  justify-content:center;padding:16px;overflow:auto;cursor:auto;
  background:
    radial-gradient(ellipse at 22% 18%, rgba(255,40,90,.34) 0%, transparent 52%),
    radial-gradient(ellipse at 80% 24%, rgba(60,200,255,.32) 0%, transparent 52%),
    radial-gradient(ellipse at 26% 84%, rgba(80,255,150,.30) 0%, transparent 52%),
    radial-gradient(ellipse at 78% 80%, rgba(190,90,255,.34) 0%, transparent 52%),
    radial-gradient(ellipse at center, rgba(10,4,16,.93) 0%, rgba(2,2,6,.985) 74%);
  animation: rgbHue 14s linear infinite, rgbGlow 8s ease-in-out infinite}
.ov.hide{display:none}

/* ── заставка «нажмите чтобы начать» ── */
#intro{position:absolute;inset:0;z-index:20;display:flex;flex-direction:column;
  align-items:center;justify-content:center;cursor:pointer;
  background:rgba(4,2,8,.92);transition:opacity .45s ease}
#intro.gone{opacity:0;pointer-events:none}
#intro .hint{font-size:clamp(14px,2.2vw,20px);letter-spacing:6px;color:#ffcf3c;
  text-shadow:0 0 14px rgba(255,207,60,.7);animation:blinkHint 1.2s ease-in-out infinite}
#intro .sub2{margin-top:14px;font-size:12px;letter-spacing:3px;color:#6b5a48}
@keyframes blinkHint{0%,100%{opacity:1}50%{opacity:.25}}

/* ── выезд лобби: быстро вылетает, чуть «садится» обратно, как магнит ── */
#menu.enter .panel{animation:panelIn .75s cubic-bezier(.2,.9,.25,1) both}
@keyframes panelIn{
  0%   { transform:translateY(-120vh) scale(.92); opacity:0; }
  55%  { transform:translateY(0) scale(1.03); opacity:1; }
  72%  { transform:translateY(0) scale(.985); }
  86%  { transform:translateY(0) scale(1.008); }
  100% { transform:translateY(0) scale(1); opacity:1; }
}
.panel{margin:auto;                /* центрируем по вертикали, пока влезает */
  width:100%;max-width:660px;text-align:center;
  border:3px solid transparent;border-radius:6px;padding:24px 20px;
  background:
    linear-gradient(180deg,rgba(14,10,20,.96),rgba(6,5,12,.98)) padding-box,
    conic-gradient(from 0deg,#ff2f5e,#ffb020,#7dff5c,#3ce0ff,#a05cff,#ff2f5e) border-box;
  box-shadow:0 0 40px rgba(160,90,255,.30),inset 0 0 70px rgba(0,0,0,.8);
  animation: rgbHue 7s linear infinite}
@keyframes rgbText{ to{ background-position: 300% center; } }
h1{font-size:clamp(28px,7vw,56px);letter-spacing:5px;line-height:1.06;
  background:linear-gradient(90deg,#ff2f5e,#ffb020,#7dff5c,#3ce0ff,#a05cff,#ff2f5e);
  background-size:300% auto;
  -webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;
  filter:drop-shadow(0 0 18px rgba(200,120,255,.55));
  animation: rgbText 8s linear infinite}

/* ЛОГОТИП
   Радужное слово крупно, два подстрочника мельче золотом.
   Порядок важен: общее правило для span идёт ПЕРВЫМ. Специфичность
   у него та же, что у .sub и .ed, поэтому побеждает то, что ниже.
   Раньше h1 span стоял последним и перебивал их размеры. */
h1 span{display:block;color:#ffcf3c;margin-top:6px;
  -webkit-text-fill-color:#ffcf3c;
  text-shadow:0 0 16px rgba(255,207,60,.75),0 2px 0 #7a5a06;
  animation:none}
h1 .sub{font-size:.42em;letter-spacing:3px;margin-top:4px}

/* отбиваем логотип от текста: иначе «Edition» читается как
   заголовок первого абзаца, а не как часть названия */
h1{margin-bottom:18px}
h2{font-size:13px;letter-spacing:4px;margin:16px 0 6px;text-transform:uppercase;
  color:#d9c8ff;
  text-shadow:0 0 12px rgba(160,110,255,.75),0 0 24px rgba(80,200,255,.4)}
p.lead{font-size:14px;line-height:1.75;color:#c3ab8d;margin:6px 0 10px}
.lead:last-of-type{margin-bottom:4px}

p.lead b{color:#ffcf3c}
.btn{display:inline-block;margin:18px 8px 4px;padding:14px 36px;cursor:pointer;
  border:2px solid #ff3b18;border-radius:3px;background:rgba(90,14,8,.5);
  color:#ff8a6a;font-size:17px;letter-spacing:4px;text-transform:uppercase;
  font-family:inherit;font-weight:bold;transition:.12s;
  box-shadow:0 0 20px rgba(255,60,20,.28),inset 0 0 22px rgba(255,60,20,.12)}
.btn:hover,.btn:active{background:rgba(190,40,18,.6);color:#fff;
  box-shadow:0 0 34px rgba(255,60,20,.6),inset 0 0 26px rgba(255,120,60,.3)}
.btn.alt{border-color:#5a6d15;color:#c2d86a;background:rgba(30,40,8,.5)}
.btn.alt:hover{background:rgba(70,95,14,.6);color:#fff;
  box-shadow:0 0 30px rgba(160,200,40,.5)}
.ctl{margin-top:16px;padding-top:14px;border-top:1px solid rgba(200,150,90,.22);
  font-size:12px;line-height:2.1;color:#9c8a72}
kbd{display:inline-block;background:rgba(255,207,60,.1);border:1px solid rgba(255,207,60,.35);
  border-radius:3px;padding:1px 7px;color:#ffcf3c;font-size:11px;margin:0 2px}
.music b{color:#c2d86a}
#scoreBig{font-size:clamp(26px,7vw,48px);color:#ffcf3c;letter-spacing:3px;
  text-shadow:0 0 22px rgba(255,207,60,.7);margin:8px 0}
#taunt{font-size:15px;line-height:1.8;color:#ff8a6a;margin:10px 0 2px}
#stats{font-size:13px;color:#9c8a72;line-height:2}

/* ---- выбор режима ---- */
.modes{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:10px 0 4px}
.mode{cursor:pointer;font-family:inherit;text-align:left;padding:10px 12px;
  border:2px solid #4a2a20;border-radius:3px;background:rgba(26,14,12,.78);
  color:#a8907a;transition:.12s}
.mode b{display:block;font-size:13px;letter-spacing:1.5px;color:#c9a06a}
.mode i{display:block;font-size:10.5px;font-style:normal;color:#7c6a58;
  margin-top:3px;line-height:1.35}
.mode:hover{border-color:#8a5a40}
.mode.on{border-color:#ff3b18;background:rgba(120,26,14,.6);
  box-shadow:0 0 18px rgba(255,60,20,.32)}
.mode.on b{color:#ff8a6a}
.mode.on i{color:#b39272}
@media(max-width:540px){.modes{grid-template-columns:1fr}}

/* ---------------- ЭКВАЛАЙЗЕР В ЛОББИ ----------------
   Полоски пляшут в такт будущей песне. Сейчас — статичная анимация,
   к ней легко подцепить реальный анализатор через Web Audio. */
/* подпись играющего трека */
/* эквалайзер занимает отдельную строку во всю ширину панели */
.nowplaying{display:flex;align-items:center;gap:9px;margin:12px 0 4px;
  font-size:12px;letter-spacing:1px;color:#9c8a72;line-height:1.7;
  justify-content:center}
.nowplaying span{text-align:center}
.nowplaying b{color:#d9c8ff;
  text-shadow:0 0 12px rgba(160,110,255,.7)}
#eqMini,#eqMini2{display:block;width:120px;height:18px;border-radius:3px;
  background:rgba(6,6,12,.6);flex:none;
  box-shadow:0 0 10px rgba(160,90,255,.35),
             inset 0 0 6px rgba(0,0,0,.6)}

/* ---------------- плеер ---------------- */
.player{margin:12px 0 4px;display:flex;flex-direction:column;gap:9px}

.pline{display:flex;align-items:center;gap:9px}
.ptime{font-size:11px;color:#8a7a5c;min-width:38px;text-align:center;
  font-variant-numeric:tabular-nums;letter-spacing:.5px}
.ptime:first-child{text-align:right}
.ptime:last-child{text-align:left}

/* полоса перемотки: тонкая, в цвет панели */
.pbar{-webkit-appearance:none;appearance:none;flex:1;height:4px;border-radius:2px;
  background:rgba(200,150,90,.22);outline:none;cursor:pointer}
.pbar::-webkit-slider-thumb{-webkit-appearance:none;width:11px;height:11px;
  border-radius:50%;background:#ffcf3c;cursor:pointer;
  box-shadow:0 0 8px rgba(255,207,60,.8)}
.pbar::-moz-range-thumb{width:11px;height:11px;border:none;border-radius:50%;
  background:#ffcf3c;cursor:pointer;box-shadow:0 0 8px rgba(255,207,60,.8)}
.pbar::-moz-range-track{height:4px;border-radius:2px;
  background:rgba(200,150,90,.22)}

.pctrl{display:flex;align-items:center;justify-content:center;gap:7px;flex-wrap:wrap}

.pbtn{cursor:pointer;font-family:inherit;font-size:13px;line-height:1;
  width:32px;height:30px;border-radius:3px;padding:0;transition:.12s;
  border:1px solid rgba(200,150,90,.28);
  background:rgba(24,14,20,.7);color:#c9a06a;
  display:flex;align-items:center;justify-content:center;position:relative}
.pbtn:hover{border-color:rgba(255,207,60,.6);color:#ffcf3c;
  background:rgba(40,24,30,.85)}
.pbtn:active{transform:translateY(1px)}

.pbtn.main{width:42px;height:34px;font-size:15px;
  border-color:rgba(255,207,60,.45);color:#ffcf3c;
  background:rgba(40,26,14,.8)}
.pbtn.main:hover{box-shadow:0 0 14px rgba(255,207,60,.35)}

/* режимы плейлиста: активный подсвечен */
.pbtn.pmod.on{border-color:#ffcf3c;color:#ffcf3c;
  background:rgba(60,38,12,.9);
  box-shadow:0 0 12px rgba(255,207,60,.35)}
.pbtn.pmod i{position:absolute;right:2px;bottom:0;font-size:8px;
  font-style:normal;font-weight:bold;opacity:.9}

.psep{width:1px;height:20px;background:rgba(200,150,90,.25);margin:0 3px}

.ptotal{font-size:11px;color:#8a7a5c;margin-left:4px;
  font-variant-numeric:tabular-nums}

/* ---- своя музыка ---- */
.musicbox{display:flex;flex-direction:column;align-items:center;gap:9px;
  margin:10px 0 8px}

.addbtn{cursor:pointer;font-family:inherit;font-size:11px;letter-spacing:1.6px;
  padding:7px 16px;border-radius:3px;transition:.14s;
  border:1px dashed rgba(160,120,255,.45);
  background:rgba(30,18,44,.55);color:#c9b0ff}
.addbtn:hover{border-color:rgba(160,120,255,.85);
  background:rgba(48,28,70,.7);color:#e6dbff;
  box-shadow:0 0 16px rgba(160,110,255,.35)}
.addbtn.hasfile{border-style:solid;border-color:rgba(140,255,190,.55);
  color:#b6ffd4}

.mopts{display:flex;flex-wrap:wrap;gap:6px 16px;justify-content:center}
.mopt{display:flex;align-items:center;gap:6px;cursor:pointer;
  font-size:11px;letter-spacing:.6px;color:#9c8a72;transition:.12s}
.mopt:hover{color:#c9b0ff}
.mopt.on{color:#d9c8ff}
.mopt input{accent-color:#a06cff;cursor:pointer;margin:0;flex:none}
.mopt span{pointer-events:none}

.mhint{font-size:10px;letter-spacing:1px;color:#8a7a5c;
  min-height:13px;line-height:1.4;text-align:center}
.mhint.err{color:#ff7a5c}

@media(max-width:480px){
  .nowplaying{font-size:11px;gap:7px}
  #eqMini,#eqMini2{width:96px;height:15px}
  .mopt{font-size:10px;gap:4px}
  .mopts{gap:5px 10px}
}

/* ---------------- настройки звука ---------------- */
.settings{margin:10px 0 2px;border-top:1px solid rgba(200,150,90,.22);
  padding-top:14px;text-align:left}
.srow{display:flex;align-items:center;gap:10px;margin:11px 0}
.slabel{font-size:11px;letter-spacing:2px;color:#c9a06a;width:62px;flex:none}
.sw{cursor:pointer;font-family:inherit;font-size:11px;letter-spacing:1px;
  padding:5px 9px;border:2px solid #5a6d15;border-radius:3px;
  background:rgba(30,40,8,.5);color:#c2d86a;min-width:54px;flex:none;
  transition:.12s;font-weight:bold}
.sw:hover{filter:brightness(1.35)}
.sw.off{border-color:#6d1512;background:rgba(40,10,12,.6);color:#7a5a4a}
input[type=range]{-webkit-appearance:none;appearance:none;flex:1;
  height:6px;border-radius:3px;outline:none;cursor:pointer;border:none;
  background:linear-gradient(90deg,#ff3b18 0%,#ffcf3c 100%)}
input[type=range].off{background:#3a2a24}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;
  width:17px;height:17px;border-radius:50%;background:#e8dcc8;
  border:2px solid #6d1512;cursor:pointer;
  box-shadow:0 0 9px rgba(255,60,20,.75)}
input[type=range]::-moz-range-thumb{width:17px;height:17px;border-radius:50%;
  background:#e8dcc8;border:2px solid #6d1512;cursor:pointer;
  box-shadow:0 0 9px rgba(255,60,20,.75)}
.sval{font-size:11px;color:#8a7a5c;width:38px;text-align:right;flex:none;
  font-variant-numeric:tabular-nums}
</style>
</head>
<body>
<div id="wrap">
  <canvas id="game" width="1152" height="888"></canvas>

  <!-- ЗАСТАВКА: нажмите любую кнопку, чтобы начать -->
  <div id="intro">
    <div class="hint">НАЖМИТЕ ЛЮБУЮ КНОПКУ, ЧТОБЫ НАЧАТЬ</div>
    <div class="sub2">клик · пробел · любая клавиша</div>
  </div>

  <!-- ЛОББИ -->
  <div class="ov" id="menu">
    <div class="panel">
      <h1>Змейка<br><span class="sub">(Для кентиков Edition)</span></h1>

      <p class="lead">
        Привет. И это бета версия, разрабатываемая с помощью ии.<br>
        Тут всё сделано на моё усмотрение, начиная от стиля,<br>
        заканчивая просчётом приоритета цели и добавлением собственной музыки вместе с кучей игровых условностей. (так что не нейро слоп "сосать")<br>
        Буду рад, если предложишь микро идейки для этой игрульки.<br>
        Довёл игру уже до играбельности, после кучи патчей и исправлений (но полностью багов пока избежать не удалось, парочку есть)<br>
        Бля, забыл сказать, самое сложное было сделать плеер, это блять буквально POV: кончилась подписка на Claude Opus 5.5</p>

      <h2>управление</h2>
      <div class="ctl">
        <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> или <kbd>↑↓←→</kbd> — ползти<br>
        <b>ОТСТРЕЛ САМ</b>: червяк бьёт по ближайшей стене пулей из головы (1 патрон, 2с)<br>
        <kbd>ESC</kbd> — пауза &nbsp; <kbd>R</kbd> — заново<br>
        <b style="color:#7cf0ff">ГОЛОД</b>: сферу нужно есть раз в 30 секунд, иначе смерть<br>
        На телефоне: <b>свайпы</b>
      </div>
      <h2>настройки</h2>
      <div class="settings">
        <div class="srow">
          <span class="slabel">ЗВУКИ</span>
          <button class="sw" id="swSfx">ВКЛ</button>
          <input type="range" id="volSfx" min="0" max="100" value="70">
          <span class="sval" id="valSfx">70%</span>
        </div>
        <div class="srow">
          <span class="slabel">МУЗЫКА</span>
          <button class="sw" id="swMus">ВКЛ</button>
          <input type="range" id="volMus" min="0" max="100" value="55">
          <span class="sval" id="valMus">55%</span>
        </div>
      </div>
      <h2>сложность</h2>
      <div class="modes" id="modes">
        <button class="mode" data-i="0"><b>НИЗКАЯ</b>
          <i>скорость 5.0 · этап на 14-й секунде</i></button>
        <button class="mode" data-i="1"><b>СРЕДНЯЯ</b>
          <i>скорость 6.3 · этап на 11-й секунде</i></button>
        <button class="mode" data-i="2"><b>ВЫСОКАЯ</b>
          <i>скорость 7.9 · этап на 9-й секунде</i></button>
        <button class="mode" data-i="3"><b>ОЧЕНЬ ВЫСОКАЯ</b>
          <i>скорость 9.5 · этап на 7-й секунде</i></button>
      </div>
      <div class="nowplaying" id="nowPlaying">
        <canvas id="eqMini" width="320" height="48"></canvas>
        <span>Играет: <b class="trackname">Pooka - MAYBE SO/MUGENMIRAI</b></span>
      </div>

      <!-- ── ПЛЕЕР ── -->
      <div class="player" id="player">
        <div class="pline">
          <span class="ptime" id="tNow">0:00</span>
          <input class="pbar" id="pSeek" type="range" min="0" max="1000" value="0" step="1">
          <span class="ptime" id="tLeft">-0:00</span>
        </div>

        <div class="pctrl">
          <button class="pbtn" id="pPrev" type="button" title="предыдущая">&#9198;</button>
          <button class="pbtn main" id="pPlay" type="button" title="пауза">&#10074;&#10074;</button>
          <button class="pbtn" id="pNext" type="button" title="следующая">&#9197;</button>

          <span class="psep"></span>

          <button class="pbtn pmod on" id="mCycle" type="button" title="по порядку">&#8635;</button>

          <span class="ptotal" id="tTotal">0:00</span>
        </div>

      </div>

      <!-- своя музыка: загрузка файла и выбор источника -->
      <div class="musicbox">
        <button class="addbtn" id="addMusicBtn" type="button">+ ДОБАВИТЬ МУЗЫКУ</button>
        <input type="file" id="musicFile" accept=".mp3,audio/mpeg" hidden>
        <div class="mopts">
          <label class="mopt"><input type="radio" class="musradio" name="musmodeL" value="user"><span>только своя</span></label>
          <label class="mopt"><input type="radio" class="musradio" name="musmodeL" value="both"><span>игровая и своя</span></label>
          <label class="mopt"><input type="radio" class="musradio" name="musmodeL" value="game" checked><span>только игровая</span></label>
        </div>
        <div class="mhint" id="musicHint"></div>
      </div>
      <button class="btn" id="startBtn">НАЧАТЬ ЗАБЕГ</button>
      
    </div>
  </div>

  <!-- ПАУЗА -->
  <div class="ov hide" id="pause">
    <div class="panel">
      <h1 style="font-size:clamp(24px,6vw,44px)">ЗАДУМАЛСЯ</h1>
      <p class="lead">Игра на паузе.</p>
      <div class="nowplaying">
        <canvas id="eqMini2" width="320" height="48"></canvas>
        <span>Играет: <b class="trackname">Pooka - MAYBE SO/MUGENMIRAI</b></span>
      </div>

      <!-- плеер на паузе: тот же, что в лобби, но с суффиксом 2.
           Состояние общее — переключение здесь меняет и лобби -->
      <div class="player" id="player2">
        <div class="pline">
          <span class="ptime" id="tNow2">0:00</span>
          <input class="pbar" id="pSeek2" type="range" min="0" max="1000" value="0" step="1">
          <span class="ptime" id="tLeft2">-0:00</span>
        </div>

        <div class="pctrl">
          <button class="pbtn" id="pPrev2" type="button" title="предыдущая">&#9198;</button>
          <button class="pbtn main" id="pPlay2" type="button" title="пауза">&#10074;&#10074;</button>
          <button class="pbtn" id="pNext2" type="button" title="следующая">&#9197;</button>

          <span class="psep"></span>

          <button class="pbtn pmod on" id="mCycle2" type="button" title="по порядку">&#8635;</button>

          <span class="ptotal" id="tTotal2">0:00</span>
        </div>
      </div>

