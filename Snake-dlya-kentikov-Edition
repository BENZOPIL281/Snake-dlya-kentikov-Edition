  G.escT = MODES[G.modeIdx].esc0;      /* первый этап приходит рано */
  G.pickupCd = 3.0;      /* первая аптечка/патроны не сразу */
  G.soulCd   = 0.3;      /* сфера появляется сразу, она тут главная */

  buildArena();       /* поле: рамка плюс стартовые глыбы */

  /* с самого начала немного препятствий — пустого поля больше нет */
  const startBlocks = MODES[G.modeIdx].blocks + 2;
  for (let i = 0; i < startBlocks; i++) addBlock();
  /* и пара бочек, чтобы сразу приходилось думать */
