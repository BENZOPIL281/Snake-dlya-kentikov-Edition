function loadSettings(){
  try {
    const raw = localStorage.getItem('doomSnakeSettings');
    if (!raw) return;
    const o = JSON.parse(raw);
    if (typeof o.sfxOn  === 'boolean') SET.sfxOn  = o.sfxOn;
    if (typeof o.musOn  === 'boolean') SET.musOn  = o.musOn;
    if (typeof o.sfxVol === 'number')  SET.sfxVol = clamp(o.sfxVol, 0, 1);
    if (typeof o.musVol === 'number')  SET.musVol = clamp(o.musVol, 0, 1);
  } catch(e){}
}

