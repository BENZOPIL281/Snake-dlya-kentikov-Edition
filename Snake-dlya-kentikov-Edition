/* ══════════════════════ СВОЯ МУЗЫКА ══════════════════════
   Кнопка выбора mp3, три переключателя источника и обновление
   подписи «Играет: …» во всех местах сразу. */

/* ══════════════════ СВОЯ МУЗЫКА + ПЛЕЕР ══════════════════
   Блоки есть в двух местах: лобби и меню паузы. Элементы
   различаются суффиксом: pSeek в лобби, pSeek2 в паузе.
   Логика одна, навешивается на обе копии.

   Состояние живёт в Music, а не в интерфейсе, поэтому при
   переходе «игра → пауза → лобби» ничего не сбивается:
   позиция, режим и выбранный трек сохраняются. */

/* секунды → «2:03» */
function fmt(sec){
  if (!isFinite(sec) || sec < 0) sec = 0;
  const m = Math.floor(sec / 60);
  const s = Math.floor(sec % 60);
  return m + ':' + (s < 10 ? '0' : '') + s;
}

/* Одна и та же петля для «случайная» и «одна и та же».
   Различаются только цифрой 1 в правом нижнем углу.
   Текстовые стрелки, а не эмодзи: эмодзи рисуется цветным
   смайликом и выбивается из монохромной панели. */
const MODE_ICON = {
  all:     '&#8635;',            /* по порядку */
  shuffle: '&#8646;',            /* случайная */
  one:     '&#8635;<i>1</i>'     /* одна и та же: та же петля с единицей */
};
const MODE_HINT = {
  all:     'по порядку',
  shuffle: 'случайная',
  one:     'одна и та же'
};

/* ── один экземпляр плеера ── */
function makePlayerUi(sfx){
  const ui = {
    seek:  el('pSeek'  + sfx),
    play:  el('pPlay'  + sfx),
    now:   el('tNow'   + sfx),
    left:  el('tLeft'  + sfx),
    total: el('tTotal' + sfx),
    prev:  el('pPrev'  + sfx),
    next:  el('pNext'  + sfx),
    mode:  el('mCycle' + sfx),
    seeking: false
  };

  if (ui.seek){
    /* пока тянем ползунок — показываем выбранное время,
       трек не дёргаем: иначе он перезапускался бы на каждом пикселе */
    ui.seek.addEventListener('input', e => {
      e.stopPropagation();
      ui.seeking = true;
      const d = Music.duration;
      if (d > 0){
        const v = parseInt(ui.seek.value, 10) / 1000;
        if (ui.now)  ui.now.textContent  = fmt(v * d);
        if (ui.left) ui.left.textContent = '-' + fmt(Math.max(0, d - v*d));
      }
    });

    ui.seek.addEventListener('change', e => {
      e.stopPropagation();
      unlockAudio();
      const d = Music.duration;
      if (d > 0) Music.seek(parseInt(ui.seek.value, 10) / 1000 * d);
      ui.seeking = false;
      syncPlayers();
    });

    ['pointerdown','touchstart','mousedown'].forEach(ev =>
      ui.seek.addEventListener(ev, e => e.stopPropagation()));
  }

  if (ui.play) ui.play.addEventListener('click', e => {
    e.stopPropagation();
    unlockAudio();
    if (Music.paused) Music.resumePlayback();
    else              Music.pausePlayback();
    syncPlayers();
  });

  if (ui.prev) ui.prev.addEventListener('click', e => {
    e.stopPropagation(); unlockAudio();
    Music.prevTrack(); syncPlayers();
  });

  if (ui.next) ui.next.addEventListener('click', e => {
    e.stopPropagation(); unlockAudio();
    Music.nextTrack(); syncPlayers();
  });

  if (ui.mode) ui.mode.addEventListener('click', e => {
    e.stopPropagation();
    /* Смена режима — чисто логическая операция. Ни звук, ни сеть
       тут не нужны, поэтому всё под try: даже если аудио упадёт,
       интерфейс и игра останутся живыми. */
    try {
      Music.cyclePlayMode();
      syncPlayers();
    } catch(err){
      try { console.warn('режим:', err); } catch(_){}
    }
    try { unlockAudio(); } catch(err){}
  });

  /* кнопки не должны дважды запускать глобальную разблокировку */
  [ui.prev, ui.next, ui.mode, ui.play].forEach(b => {
    if (!b) return;
    ['pointerdown','touchstart','mousedown'].forEach(ev =>
      b.addEventListener(ev, e => e.stopPropagation()));
  });

  return ui;
}

const players = [ makePlayerUi(''), makePlayerUi('2') ];

/* ── обновить оба плеера разом ── */
function syncPlayers(){
  for (const ui of players){
    if (ui.play){
      ui.play.innerHTML = Music.paused ? '&#9654;' : '&#10074;&#10074;';
      ui.play.title = Music.paused ? 'играть' : 'пауза';
    }
    if (ui.mode){
      const m = Music.playMode;
      ui.mode.innerHTML = MODE_ICON[m] || MODE_ICON.all;
      ui.mode.title = MODE_HINT[m] || MODE_HINT.all;
    }
  }
  syncMusicUI();
}

/* ── каждый кадр: ползунок и время в обоих местах ── */
function tickPlayers(){
  const d = Music.duration;
  const e = Music.elapsed;

  for (const ui of players){
    if (d <= 0){
      if (ui.total) ui.total.textContent = '0:00';
      continue;
    }
    if (ui.total) ui.total.textContent = fmt(d);
    if (ui.seeking) continue;

    if (ui.seek) ui.seek.value = String(Math.round((e / d) * 1000));
    if (ui.now)  ui.now.textContent  = fmt(e);
    if (ui.left) ui.left.textContent = '-' + fmt(Math.max(0, d - e));
  }
  requestAnimationFrame(tickPlayers);
}

/* ── обновить панели прямо сейчас ──
   Вызывается при открытии лобби и паузы: пока панель была скрыта,
   время шло, и ползунок с цифрами надо догнать. Состояние берём
   из Music, поэтому обе панели приходят к одному виду. */
function refreshPlayer(){
  syncPlayers();

  const d = Music.duration;
  if (d <= 0) return;

  const e = Music.elapsed;

  for (const ui of players){
    if (ui.total) ui.total.textContent = fmt(d);
    if (ui.seek)  ui.seek.value = String(Math.round((e / d) * 1000));
    if (ui.now)   ui.now.textContent  = fmt(e);
    if (ui.left)  ui.left.textContent = '-' + fmt(Math.max(0, d - e));
  }
}

/* ══════════════════ СВОЯ МУЗЫКА ══════════════════
   Кнопка выбора файла, переключатели источника и подпись.
   Блок тоже в двух местах — обрабатываем все найденные. */

function syncMusicUI(){
  const has = Music.hasUser();
  const src = Music.source;

  document.querySelectorAll('.addbtn').forEach(b => {
    b.classList.toggle('hasfile', has);
    b.textContent = has ? '+ ЗАМЕНИТЬ МУЗЫКУ' : '+ ДОБАВИТЬ МУЗЫКУ';
  });

  document.querySelectorAll('.musradio').forEach(r => {
    r.checked = (r.value === src);
    const lab = r.parentElement;
    if (lab) lab.classList.toggle('on', r.checked);
  });
}

/* провод для пары «кнопка + файл + подпись» */
function wireMusicBox(btnId, fileId, hintId){
  const btn  = el(btnId);
  const file = el(fileId);
  const hint = el(hintId);
  if (!btn || !file) return;

  btn.addEventListener('click', e => {
    e.stopPropagation();
    unlockAudio();
    file.click();
  });

  file.addEventListener('change', async e => {
    e.stopPropagation();
    const f = file.files && file.files[0];
    if (!f) return;

    const isMp3 = /\.mp3$/i.test(f.name) || f.type === 'audio/mpeg';
    if (!isMp3){
      if (hint){ hint.textContent = 'нужен файл mp3'; hint.classList.add('err'); }
      return;
    }

    if (hint){ hint.classList.remove('err'); hint.textContent = 'загружаю…'; }

    try {
      const r = await Music.loadUserFile(f);
      if (hint) hint.textContent = 'своя музыка: ' + Math.round(r.seconds) + 'с';

      /* Сразу переключаемся на свою: иначе файл загружен,
         а играет по-прежнему игровая — выглядит как поломка. */
      Music.setSource('user');
      Music.start();
      syncPlayers();
    } catch(err){
      if (hint){ hint.textContent = 'не удалось прочитать mp3'; hint.classList.add('err'); }
    }

    /* сбрасываем input, чтобы можно было выбрать тот же файл снова */
    file.value = '';
  });

  ['pointerdown','touchstart','mousedown'].forEach(ev =>
    btn.addEventListener(ev, e => e.stopPropagation()));
}

wireMusicBox('addMusicBtn',  'musicFile',  'musicHint');
wireMusicBox('addMusicBtn2', 'musicFile2', 'musicHint2');

/* переключатели источника — общие для обеих копий */
document.querySelectorAll('.musradio').forEach(r => {
  r.addEventListener('change', e => {
    e.stopPropagation();
    if (!r.checked) return;
    unlockAudio();
    Music.setSource(r.value);
    syncPlayers();
  });
  ['pointerdown','touchstart','mousedown'].forEach(ev =>
    r.addEventListener(ev, e => e.stopPropagation()));
});

/* подпись трека — во всех местах сразу */
Music.onTitleChange(t => {
  document.querySelectorAll('.trackname').forEach(b => { b.textContent = t; });
});

syncPlayers();
tickPlayers();

applySettings();


/* ── РАЗБЛОКИРОВКА ЗВУКА ──────────────────────────────────────────────
   Браузеры пускают звук только после жеста пользователя.

   Была тонкая ошибка: слушатель висел в фазе ВСПЛЫТИЯ, а ВСЕ кнопки игры
   вызывают e.stopPropagation() — клик по кнопке до разблокировки не
   доходил. Работал только клик по пустому месту, где событие никто
   не гасил.

   Теперь слушаем в фазе ПЕРЕХВАТА на самом документе: она срабатывает
   раньше обработчиков кнопки, и stopPropagation её не останавливает. */
function unlockAudio(){
  try { if (Snd) Snd.unlock(); } catch(e){}
  try { if (Music) Music.start(); } catch(e){}
}

['pointerdown','mousedown','pointerup','touchstart','touchend','click','keydown']
  .forEach(ev => document.addEventListener(ev, unlockAudio, true));

/* страховка: если контекст уснул или запуск сорвался — добиваем,
   пока музыка не зазвучит. На скрытой вкладке не тратим силы. */
setInterval(() => {
  if (Music.playing) return;
  if (document.visibilityState !== 'visible') return;
  Music.start();
}, 700);

/* ── заставка: лобби появляется после первого нажатия ── */
(function(){
  const intro = document.getElementById('intro');
  const menu  = document.getElementById('menu');
  if (!intro || !menu) return;

  let done = false;
  function reveal(){
    if (done) return;
    done = true;
    intro.classList.add('gone');
    menu.classList.remove('hide');
    menu.classList.add('enter');
    setTimeout(() => intro.remove(), 500);
  }

  ['pointerdown','keydown','touchstart'].forEach(ev => {
    window.addEventListener(ev, reveal, { once:true, passive:true });
  });
})();

/* ================================================================= ЦИКЛ == */
let last = performance.now();
let frames = 0;

function loop(now){
  /* Следующий кадр планируем ДО работы и оборачиваем её в try.
     Раньше исключение в update/render убивало requestAnimationFrame,
     и игра замирала навсегда — кнопки нажимались, но экран стоял. */
  requestAnimationFrame(loop);

  const dt = Math.min(0.05, (now - last)/1000);
  last = now;

  try {
    update(dt);
    render();
    drawSpectrum();      /* отдельный канвас — виден и в лобби, и в игре */
    frames++;
  } catch(err){
    /* Один битый кадр не должен стоить игроку всей партии */
    if (!loop._warned){
      loop._warned = true;
      try { console.error('кадр пропущен:', err); } catch(e){}
    }
  }
}

