/* ============================================================ ОБНОВЛЕНИЕ == */
function stepSnake(){
  const h = G.snake[0];

  if (G.queue.length){
    const nd = G.queue.shift();
    if (nd.x === -G.dir.x && nd.y === -G.dir.y){ die('turn'); return; }
    if (!(nd.x === G.dir.x && nd.y === G.dir.y)){ G.dir = nd; Snd.turn(); }
  }

  const nx = h.x + G.dir.x, ny = h.y + G.dir.y;

  /* стена */
  if (isWall(nx,ny)){ die('wall'); return; }

  /* препятствие: просто стена, наскочил — конец */
  if (G.barrels.some(b => b.x===nx && b.y===ny)){ die('barrel'); return; }

  /* себя */
  const last = G.snake.length - 1;
  for (let i=0;i<G.snake.length;i++){
    if (i === last && G.grow === 0) continue;      // хвост уйдёт в этом шаге
    if (G.snake[i].x === nx && G.snake[i].y === ny){ die('self'); return; }
  }

  G.snake.unshift({x:nx, y:ny});

  /* предмет */
  const pi = G.pickups.findIndex(p => p.x===nx && p.y===ny);
  if (pi >= 0){
    const p = G.pickups[pi];
    G.pickups.splice(pi,1);
    Snd.pick();
    G.flash = .3; G.flashCol = p.t==='med' ? '#54d67a' : p.t==='ammo' ? '#ffcf3c' : '#7cf0ff';
    const px = nx*TILE+TILE/2, py = ny*TILE+TILE/2;
    if (p.t === 'med'){
      /* сердечко возвращает одно из трёх. Если полон — оно не пропадает
         зря, а превращается в очки: 40 вместо 10. */
      if (G.hp < G.maxHp){
        G.hp = Math.min(G.maxHp, G.hp + 1);
        G.score += 10;
        announce('+1 СЕРДЦЕ', '#ffffff', 1.1);
      } else {
        G.score += 40;
        announce('СЕРДЦА ПОЛНЫ +40', '#ffffff', 1.1);
      }
      burst(px,py,16,'#ffffff',90,.5);
    } else if (p.t === 'ammo'){
      /* патроны — только для отстрела стен */
      G.score += 20;
      G.ammo = Math.min(AMMO_MAX, G.ammo + 5);
      burst(px,py,16,'#ffcf3c',90,.5);
      announce('+5 ЭНЕРГИИ', '#ffcf3c', 1.1);
    } else {
      /* ЕДИНСТВЕННЫЙ источник роста длины */
      G.score += 50;  G.grow += 2;
      G.holy = 1.2;
      G.soulCd = MODES[G.modeIdx].soulDelay;   /* следующая появится с задержкой */
      G.hunger = HUNGER_MAX;                   /* сфера — это еда: голод обнулён */
      G.hungerWarn = 0;
      burst(px,py,24,'#7cf0ff',120,.7);
      announce('СФЕРА +2 К ДЛИНЕ', '#7cf0ff', 1.4);
    }
  }

  if (G.grow > 0) G.grow--; else G.snake.pop();

  G.steps++;
  if (G.steps % 12 === 0) G.score += 1;
}

/* ---------------------------------------------------------------------------
   ОТСТРЕЛ СТЕН.

   Раньше пробел вышибал клетку РОВНО перед головой — но змейка ползёт
   непрерывно, подойти вплотную и успеть нажать физически невозможно,
   поэтому казалось, что отстрел не работает вовсе.

   Теперь стрельба АВТОМАТИЧЕСКАЯ: как только патрон готов, червяк сам
   находит ближайшую стену в передней полусфере и посылает в неё пулю.
   Пуля вылетает из головы и летит к цели, выбивая стену при попаренынии.
   Рамку арены не пробиваем — иначе змейка сбежит.
   --------------------------------------------------------------------------- */

/* можно ли стрелять в эту клетку: внутри арены, не рамка, не пол */
function isShootable(cx, cy){
  if (!inB(cx, cy)) return false;
  if (cx <= 0 || cy <= 0 || cx >= COLS-1 || cy >= ROWS-1) return false;
  return at(cx, cy) !== FLOOR;
}

/* ближайшая стена. Сначала проверяем клетку прямо по курсу — это смерть,
   потом самую близкую стену в передней полусфере радиусом 6 клеток. */
/* ВЫБОР ЦЕЛИ.
   Приоритет всегда у Врага, даже если стена ближе. Стреляем в него,
   если он в передней полусфере в пределах досягаемости. Если Врагов
   рядом нет — бьём по ближайшей стене. */
function findWallTarget(){
  const h = G.snake[0];
  if (!h) return null;

  const R = 8;

  /* ── сначала Враги ── */
  let bestH = null, bestHD = 1e9;
  for (const im of G.hunters){
    const dx = im.x - h.x, dy = im.y - h.y;
    const d = Math.abs(dx) + Math.abs(dy);
    if (d === 0 || d > R) continue;
    if (dx*G.dir.x + dy*G.dir.y < 0) continue;   /* только впереди */
    if (d < bestHD){ bestHD = d; bestH = { x:im.x, y:im.y, hunter:true }; }
  }
  if (bestH) return bestH;

  /* ── потом стены: сначала клетка прямо по курсу ── */
  const ax = h.x + G.dir.x, ay = h.y + G.dir.y;
  if (isShootable(ax, ay)) return { x:ax, y:ay, hunter:false };

  let best = null, bestD = 1e9;
  for (let dy = -6; dy <= 6; dy++){
    for (let dx = -6; dx <= 6; dx++){
      if (!dx && !dy) continue;
      const d = Math.abs(dx) + Math.abs(dy);
      if (d > 6 || d >= bestD) continue;
      if (dx*G.dir.x + dy*G.dir.y < 0) continue;
      const cx = h.x + dx, cy = h.y + dy;
      if (!isShootable(cx, cy)) continue;
      bestD = d;
      best = { x:cx, y:cy, hunter:false };
    }
  }
  return best;
}

/* пустить пулю из головы в сторону клетки */
function fireAt(tx, ty){
  const h = G.snake[0];
  const sx = h.x*TILE + TILE/2;
  const sy = h.y*TILE + TILE/2;
  const ex = tx*TILE + TILE/2;
  const ey = ty*TILE + TILE/2;
  const dx = ex - sx, dy = ey - sy;
  const dist = Math.hypot(dx, dy) || 1;

  G.bullets.push({
    x: sx, y: sy,
    vx: dx/dist * BULLET_SPEED,
    vy: dy/dist * BULLET_SPEED,
    left: dist, tx, ty, trail: []
  });

  G.ammo--;
  G.shootCd = 2.0;              /* перезарядка ровно 2 секунды */
  G.shotFired++;
  G.shotsFired++;
  Snd.shoot();
}

/* автоматический выстрел — сам, как только патрон готов */
function autoFire(){
  if (G.state !== 'play' || !G.armed) return;
  if (G.shootCd > 0 || G.ammo <= 0) return;
  const tgt = findWallTarget();
  if (!tgt) return;             /* рядом нет стен — патрон не тратим */
  fireAt(tgt.x, tgt.y);
}

/* полёт пуль и разрушение стены в точке попареныния */
function updateBullets(dt){
  for (let i = G.bullets.length - 1; i >= 0; i--){
    const b = G.bullets[i];
    b.x += b.vx * dt;
    b.y += b.vy * dt;
    b.left -= BULLET_SPEED * dt;

    b.trail.push(b.x, b.y);
    if (b.trail.length > 16) b.trail.splice(0, 2);

    if (b.left <= 0){
      /* сперва Враг: даже если в клетке оказалась стена,
         цель важнее препятствия */
      const hi = G.hunters.findIndex(im =>
        Math.abs(im.x - b.tx) <= 1 && Math.abs(im.y - b.ty) <= 1);
      if (hi >= 0){
        G.hunters.splice(hi, 1);
        G.kills++;                 /* Враг снят пулей — идёт в счётчик */
        G.score += 40;
        G.shake = Math.min(14, G.shake + 6);
        const hxx = b.tx*TILE + TILE/2, hyy = b.ty*TILE + TILE/2;
        burst(hxx, hyy, 26, '#ffffff', 160, .6);
        burst(hxx, hyy, 14, '#4a9eff', 110, .5);
        announce('ВРАГ СНЯТ +40', '#ffffff', 1.2);
        G.bullets.splice(i, 1);
        continue;
      }

      if (isShootable(b.tx, b.ty)){
        grid[b.ty*COLS + b.tx] = FLOOR;       /* стена выбита */
        paintArena();
        G.wallsShot++;
        G.score += 15;
        G.shake = Math.min(14, G.shake + 5);
        const cx = b.tx*TILE + TILE/2, cy = b.ty*TILE + TILE/2;
        burst(cx, cy, 22, '#4a9eff', 145, .55);
        burst(cx, cy, 14, '#1e5bc8', 100, .45);
        burst(cx, cy, 8,  '#d6ecff', 185, .3);
      }
      G.bullets.splice(i, 1);
    }
  }
}


/* ---------------------------------------------------------------------------
   ЗЕРКАЛЬНЫЙ ЗАЛ — выворачивает САМУ КАРТУ, а не управление.

   Раньше эффект отражал только картинку через canvas.scale(-1,1). Змейка при
   этом визуально ползла в обратную сторону, и казалось, что вывернули кнопки.
   Теперь переворачивается честно сетка стен: блок, стоявший справа, встаёт
   слева. Управление остаётся прежним, змейка слушается как обычно.
   --------------------------------------------------------------------------- */
function mirrorWorld(){
  if (!G.snake.length) return false;

  const backup = grid.slice();

  /* переворачиваем стены: x ↔ COLS-1-x */
  for (let y = 0; y < ROWS; y++){
    for (let x = 0; x < (COLS >> 1); x++){
      const a = y*COLS + x, b = y*COLS + (COLS-1-x);
      const t = grid[a]; grid[a] = grid[b]; grid[b] = t;
    }
  }

  /* всё, что стоит на карте, не должно оказаться внутри стены */
  const clearAt = (cx, cy) => {
    if (!inB(cx,cy)) return;
    if (cx <= 0 || cy <= 0 || cx >= COLS-1 || cy >= ROWS-1) return;
    grid[cy*COLS + cx] = FLOOR;
  };
  for (const sgm of G.snake)  clearAt(sgm.x, sgm.y);
  for (const b of G.barrels)  clearAt(b.x, b.y);
  for (const p of G.pickups)  clearAt(p.x, p.y);
  for (const im of G.hunters) clearAt(im.x, im.y);

  /* если переворот замуровал змейку — откатываем */
  const h = G.snake[0];
  const reach = floodCount(h.x, h.y);
  const free  = countFree();
  if (reach < Math.max(40, free*0.35)){
    grid.set(backup);
    paintArena();
    return false;
  }

  paintArena();
  return true;
}

/* Враги: медленно ползут к голове змейки и кусают при контакте */
/* ВРАГИ.
   Кусают при касании ЛЮБОГО сегмента змейки — не только головы.
   Раньше проверялась только голова, поэтому Враг мог стоять внутри
   хвоста и не наносить урона. */
function hunterBites(im){
  const S = G.snake;
  for (let k = 0; k < S.length; k++){
    if (S[k].x === im.x && S[k].y === im.y) return true;
  }
  return false;
}

function hunterHit(im){
  hurt(1, 'hunter');
  G.shake = Math.min(20, G.shake + 9);
  burst(im.x*TILE+16, im.y*TILE+16, 22, '#ffffff', 140, .6);
  announce('ВРАГ УКУСИЛ! \u22121 СЕРДЦЕ', '#ffffff', 1.5);
}

function updateHunters(dt){
  const h = G.snake[0];
  if (!h) return;

  for (let i = G.hunters.length - 1; i >= 0; i--){
    const im = G.hunters[i];
    if (!im) continue;

    im.t += dt;

    /* уже на теле — кусает немедленно, шаг не нужен */
    if (hunterBites(im)){
      G.hunters.splice(i, 1);
      hunterHit(im);
      continue;
    }

    im.moveT -= dt;
    if (im.moveT > 0) continue;
    im.moveT = 1 / Math.max(0.05, im.speed);

    const dx = h.x - im.x, dy = h.y - im.y;
    const opts = [];
    if (Math.abs(dx) >= Math.abs(dy)){
      if (dx) opts.push([Math.sign(dx), 0]);
      if (dy) opts.push([0, Math.sign(dy)]);
    } else {
      if (dy) opts.push([0, Math.sign(dy)]);
      if (dx) opts.push([Math.sign(dx), 0]);
    }
    opts.push([1,0],[-1,0],[0,1],[0,-1]);

    for (const d of opts){
      const nx = im.x + d[0], ny = im.y + d[1];
      if (isWall(nx, ny)) continue;
      if (G.barrels.some(b => b.x === nx && b.y === ny)) continue;
      if (G.hunters.some(o => o !== im && o.x === nx && o.y === ny)) continue;
      im.x = nx; im.y = ny;
      break;
    }

    /* после шага — снова проверяем всё тело */
    if (hunterBites(im)){
      G.hunters.splice(i, 1);
      hunterHit(im);
    }
  }
}

function updateCorruption(dt){
  if (G.tempT > 0){
    G.tempT -= dt;
    if (G.tempT <= 0){ G.speedMul = 1; }
  }
  if (G.flicker > 0) G.flicker -= dt;
  G.mapT += dt;
  if (MAPS[G.mapIdx].id === 'wonder') G.hueShift = (G.mapT * 42) % 360;

  if (G.mirror > 0){
    G.mirror -= dt;
    /* время вышло — возвращаем карту как была */
    if (G.mirror <= 0 && G.mirrored){
      if (mirrorWorld()) G.mirrored = false;
      else G.mirror = 2;
    }
  }
  if (G.spaghetti>0) G.spaghetti -= dt;
  if (G.holy    > 0) G.holy -= dt;

  if (G.reverse > 0) G.reverse -= dt;
  if (G.smoke   > 0) G.smoke   -= dt;
  if (G.double  > 0) G.double  -= dt;   /* двоение в глазах */
  if (G.blood   > 0) G.blood   -= dt;
  if (G.noise   > 0) G.noise   -= dt;   /* белый шум */
  if (G.dark    > 0) G.dark    -= dt;

  /* этап усложнения раз в минуту */
  G.escT -= dt;
  if (G.escT <= 0){ G.escT = MODES[G.modeIdx].escStep; escalate(); }

  /* порча арены: часто и без повторов подряд */
  G.corrT -= dt;
  if (G.corrT <= 0){
    /* выбираем событие, которого давно не было. Когда выпали все — начинаем круг заново */
    if (G.corrHist.length >= CORRUPTIONS.length) G.corrHist = [];
    let c = pick(CORRUPTIONS);
    for (let tries = 0; tries < 12 && (c.id === G.lastCorr || G.corrHist.includes(c.id)); tries++)
      c = pick(CORRUPTIONS);
    G.lastCorr = c.id;
    G.corrHist.push(c.id);

    const res = c.run();
    G.corrCount++;
    G.corrName = c.name;
    G.currCorr = c.id;
    G.corrDesc = res || '';
    /* запоминаем, КОГДА событие началось и сколько длится:
       по этим двум числам экран смерти поймёт, было ли оно активно */
    G.corrAt  = G.time;
    G.corrDur = c.dur || 0;
    G.corrCol = c.col || '#c06cff';

    /* чем дальше играешь, тем чаще сыпется; потолок зареныёт режим */
    const m = MODES[G.modeIdx];
    const base = Math.max(m.corrMin, m.corr - G.level*0.7);
    G.corrT = base + Math.random()*4.0;

    announce('СОБЫТИЕ: ' + c.name, c.col, 3.0);
    G.log = (G.corrCount + '. ' + c.name + ' — ' + res);
    G.histTxt = 'событий: ' + G.corrCount;
  }
}

function update(dt){
  G.time += dt;

  if (G.shake > 0) G.shake = Math.max(0, G.shake - dt*38);
  if (G.flash > 0) G.flash = Math.max(0, G.flash - dt*2.2);
  if (G.blink > 0) G.blink -= dt;

  /* партиклы */
  for (let i=G.particles.length-1;i>=0;i--){
    const p = G.particles[i];
    p.x += p.vx*dt; p.y += p.vy*dt;
    p.vx *= 0.94; p.vy *= 0.94; p.vy += 40*dt*0.1;
    p.life -= dt;
    if (p.life <= 0) G.particles.splice(i,1);
  }

  /* анонс */
  if (G.ann.dur > 0) G.ann.t += dt;

  if (G.shootCd > 0) G.shootCd = Math.max(0, G.shootCd - dt);

  if (G.state !== 'play') return;
  if (!G.armed) return;            /* стоим и ждём первого нажатия */

  updateCorruption(dt);
  updateHunters(dt);
  updatePickups(dt);
  updateHunger(dt);
  autoFire();          /* червяк стреляет сам */
  updateBullets(dt);   /* пули летят и выбивают стены */

  /* шаг змейки по таймеру */
  const spd = MODES[G.modeIdx].speed * G.speedMul * (1 + Math.min(1.2, G.steps/1400));
  G.stepT += dt * spd;
  while (G.stepT >= 1 && G.state === 'play'){
    G.stepT -= 1;
    stepSnake();
  }
}

/* ---------------------------------------------------------------------------
   СЛОЙ ДЛЯ ФОНАРИКА. Отдельный canvas нужен, чтобы «вырезать» свет из тьмы
   через destination-out: сначала заливаем всё чёрным, потом пробиваем конус.
   Так конус получается мягким по краям и не даёт швов.
   --------------------------------------------------------------------------- */
let _darkCv = null, _darkCtx = null;
/* буфер для «двоения в глазах»: снимок всей сцены,
   чтобы двоилось ВСЁ, а не только фон */
let _dblCv = null, _dblCtx = null;
function doubleLayer(){
  if (!_dblCv){
    _dblCv = document.createElement('canvas');
    _dblCv.width = ARENA_W;
    _dblCv.height = ARENA_H;
    _dblCtx = _dblCv.getContext('2d');
  }
  return _dblCv;
}

function darkLayer(){
  if (!_darkCv){
    _darkCv = document.createElement('canvas');
    _darkCv.width = ARENA_W;
    _darkCv.height = ARENA_H;
    _darkCtx = _darkCv.getContext('2d');
  }
  return _darkCv;
}

/* конус фонарика: пускаем лучи по сетке и обрезаем их о стены,
   чтобы свет не проходил сквозь блоки */
/* Есть ли прямая видимость от точки до центра клетки (cx,cy).
   Идём вдоль отрезка мелким шагом; если наткнулись на стену РАНЬШЕ
   цели — видимости нет. Сама цель-стена видимой считается: свет
   падает на неё, мы её видим. */
/* ══════════ ТЕНИ ОТ СТЕН ══════════

   ПОЧЕМУ ОДИНОЧНЫЕ СТЕНЫ ТО ГАСЛИ, ТО НЕТ.

   Сначала тень считалась по клеткам: смотрели, виден ли ЦЕНТР клетки,
   и гасили её целиком. Тень одной стены — узкий конус шириной с клетку.
   Клетка за ней тоже 32 пикселя, и её центр легко оказывается в просвете
   между лучами тени, хотя края закрыты. Центр виден — клетка не гаснет.
   Сдвинул голову на пару пикселей — центр попал в тень, и она появилась.
   Отсюда «иногда есть, иногда нет».

   Потом я пробовал строить трапецию от углов стены. Но начало тени
   приходилось смещать вперёд, чтобы не накрыть саму стену, и между
   стеной и тенью оставался светлый зазор.

   КАК СДЕЛАНО ТЕПЕРЬ. Для каждой стены берём её углы и проекции этих
   углов на расстояние фонарика, строим выпуклую оболочку — это и есть
   тень. А прямоугольник самой стены вырезаем из неё режимом evenodd:
   стена остаётся видимой, тень начинается ровно от её граней.
   Никаких зазоров и никакой зависимости от положения головы. */

/* выпуклая оболочка — обходом Эндрю */
function hullOf(pts){
  if (pts.length < 3) return pts;

  pts.sort((a, b) => a[0] - b[0] || a[1] - b[1]);

  const cross = (o, a, b) =>
    (a[0]-o[0]) * (b[1]-o[1]) - (a[1]-o[1]) * (b[0]-o[0]);

  const lower = [];
  for (const q of pts){
    while (lower.length >= 2 &&
           cross(lower[lower.length-2], lower[lower.length-1], q) <= 0) lower.pop();
    lower.push(q);
  }

  const upper = [];
  for (let i = pts.length - 1; i >= 0; i--){
    const q = pts[i];
    while (upper.length >= 2 &&
           cross(upper[upper.length-2], upper[upper.length-1], q) <= 0) upper.pop();
    upper.push(q);
  }

  lower.pop(); upper.pop();
  return lower.concat(upper);
}

/* угол относительно взгляда, в пределах ±π */
function relAngle(a, ang){
  let r = a - ang;
  while (r >  Math.PI) r -= Math.PI*2;
  while (r < -Math.PI) r += Math.PI*2;
  return r;
}

/* Тени всех стен в конусе. Каждая — оболочка плюс прямоугольник стены,
   который вырезается при заливке. */
/* Прямая видимость от точки до центра клетки.
   Нужна, чтобы понять, какие стены реально освещены: только их
   вырезаем из тени. Сама цель себя не заслоняет. */
function losClear(x0, y0, tx, ty, tcx, tcy){
  const dx = tx - x0, dy = ty - y0;
  const dist = Math.hypot(dx, dy);
  if (dist < 1) return true;

  const step = TILE * 0.3;
  const n = Math.ceil(dist / step);
  const ux = dx / n, uy = dy / n;

  for (let i = 1; i < n; i++){
    const gx = Math.floor((x0 + ux*i) / TILE);
    const gy = Math.floor((y0 + uy*i) / TILE);
    if (gx === tcx && gy === tcy) continue;
    if (isWall(gx, gy)) return false;
  }
  return true;
}

/* Тени всех стен в конусе.

   ФОРМА. Тень от квадратной стены — это трапеция между двумя
   СИЛУЭТНЫМИ углами (крайними по углу обзора) и их проекциями на
   расстояние фонарика. Выпуклая оболочка всех восьми точек шире:
   она захватывает и те углы, что не дают границы тени, и тень
   наползает на освещённые места сбоку.

   ВИДИМОСТЬ. Каждая стена помечается: доходит ли до неё прямая.
   По этой пометке освещённые стены вырезаются из тени — иначе
   оболочка соседа гасила бы их. */
function shadowShapes(hx, hy, ang, half, reach){
  const shapes = [];
  const span = Math.ceil(reach / TILE) + 1;
  const cx0 = Math.max(0, Math.floor(hx/TILE) - span);
  const cx1 = Math.min(COLS - 1, Math.floor(hx/TILE) + span);
  const cy0 = Math.max(0, Math.floor(hy/TILE) - span);
  const cy1 = Math.min(ROWS - 1, Math.floor(hy/TILE) + span);

  const r2 = reach * reach;

  for (let cy = cy0; cy <= cy1; cy++){
    for (let cx = cx0; cx <= cx1; cx++){
      if (!isWall(cx, cy)) continue;

      const x0 = cx*TILE, y0 = cy*TILE;
      const x1 = x0 + TILE, y1 = y0 + TILE;
      const corners = [[x0,y0], [x1,y0], [x1,y1], [x0,y1]];

      /* крайние по углу обзора углы — именно они задают границы тени */
      let minR =  Infinity, maxR = -Infinity;
      let pMin = null, pMax = null;

      for (let k = 0; k < 4; k++){
        const px = corners[k][0], py = corners[k][1];
        const dx = px - hx, dy = py - hy;
        const r = relAngle(Math.atan2(dy, dx), ang);
        if (r < minR){ minR = r; pMin = corners[k]; }
        if (r > maxR){ maxR = r; pMax = corners[k]; }
      }

      if (!pMin || !pMax) continue;
      if (pMin[0] === pMax[0] && pMin[1] === pMax[1]) continue;
      if (maxR - minR > Math.PI) continue;         /* стена за спиной */
      if (maxR < -half - 0.25 || minR > half + 0.25) continue;

      /* проекции силуэтных углов на расстояние фонарика.
         Без фильтра по конусу: иначе у стены на краю тень кособокая. */
      const proj = (px, py) => {
        const dx = px - hx, dy = py - hy;
        const d = Math.hypot(dx, dy) || 1;
        const k = (d < reach ? reach / d : 1);
        return [hx + dx*k, hy + dy*k];
      };

      const a = proj(pMin[0], pMin[1]);
      const b = proj(pMax[0], pMax[1]);

      /* доходит ли свет до самой стены */
      const wcx = x0 + TILE/2, wcy = y0 + TILE/2;
      const wdx = wcx - hx, wdy = wcy - hy;
      const inRange = (wdx*wdx + wdy*wdy) <= r2;
      const visible = inRange && losClear(hx, hy, wcx, wcy, cx, cy);

      shapes.push({
        poly: [pMin, pMax, b, a],
        wall: [x0, y0, TILE, TILE],
        visible
      });
    }
  }
  return shapes;
}

function flashlightPath(ctx, hx, hy, ang, half, reach){
  /* Почему не просто равномерная сетка лучей.
     Восемнадцати лучей на конус мало: на дальнем краю соседние лучи
     расходятся на два десятка пикселей, и одиночная стена проскакивает
     между ними. Поэтому к сетке добавляем ТОЧНЫЕ углы на углы всех стен
     в пределах досягаемости: каждый угол даёт два луча — чуть левее и
     чуть правее себя. Граница тени всегда попадает между ними, поэтому
     тень выходит резкой независимо от расстояния. */
  const a0 = ang - half, a1 = ang + half;

  /* 1. равномерная сетка — она заполняет сам конус */
  const RAYS = 84;
  const angs = [];
  for (let i = 0; i <= RAYS; i++) angs.push(a0 + (a1 - a0) * (i / RAYS));

  /* 2. углы стен, до которых достаёт фонарик */
  const span = Math.ceil(reach / TILE) + 1;
  const cx0 = Math.max(0, Math.floor(hx/TILE) - span);
  const cx1 = Math.min(COLS - 1, Math.floor(hx/TILE) + span);
  const cy0 = Math.max(0, Math.floor(hy/TILE) - span);
  const cy1 = Math.min(ROWS - 1, Math.floor(hy/TILE) + span);

  const EPS = 0.0016;          /* на сколько отступить от угла в сторону */
  const r2  = reach * reach;

  for (let cy = cy0; cy <= cy1; cy++){
    for (let cx = cx0; cx <= cx1; cx++){
      if (!isWall(cx, cy)) continue;

      const xs = [cx * TILE, cx * TILE + TILE];
      const ys = [cy * TILE, cy * TILE + TILE];

      for (let k = 0; k < 4; k++){
        const px = xs[k >> 1], py = ys[k & 1];
        const ddx = px - hx, ddy = py - hy;
        if (ddx*ddx + ddy*ddy > r2) continue;      /* слишком далеко */

        const ca = Math.atan2(ddy, ddx);

        /* угол должен лежать внутри конуса */
        let rel = ca - ang;
        while (rel >  Math.PI) rel -= Math.PI*2;
        while (rel < -Math.PI) rel += Math.PI*2;
        if (Math.abs(rel) > half + 0.03) continue;

        angs.push(ca - EPS, ca + EPS);
      }
    }
  }

  angs.sort((p, q) => p - q);

  /* 3. пускаем лучи и строим многоугольник освещённой зоны */
  const step = TILE / 5;
  ctx.beginPath();
  ctx.moveTo(hx, hy);

  let prev = -1e9;
  for (let i = 0; i < angs.length; i++){
    const a = angs[i];
    if (a - prev < 1e-5) continue;      /* почти совпадающий луч не нужен */
    prev = a;

    const cdx = Math.cos(a), cdy = Math.sin(a);
    let d = 0;
    while (d < reach){
      d += step;
      const px = hx + cdx*d, py = hy + cdy*d;
      if (px < 0 || py < 0 || px >= ARENA_W || py >= ARENA_H) break;
      if (isWall(Math.floor(px/TILE), Math.floor(py/TILE))) break;
    }
    if (d > reach) d = reach;
    /* отступаем на пиксель: иначе свет протекает сквозь грань стены */
    ctx.lineTo(hx + cdx*(d-1), hy + cdy*(d-1));
  }

  ctx.closePath();
}

/* ================================================================ РЕНДЕР == */
/* ---------------------------------------------------------------------------
   ЗМЕЙКА — чёрная с белой обводкой, без лица.
   Одинакова на всех сложностях: сложность влияет на темп, а не на вид.
   ========================================================================== */
function drawSnake(){
  const S = G.snake, n = S.length;
  const t = performance.now()/1000;

  for (let i=n-1;i>=0;i--){
    const seg = S[i];
    const taper = 1 - (i/Math.max(1,n))*0.22;
    const wob = G.spaghetti > 0 ? Math.sin(t*7 + i*0.9)*3.4 : 0;
    const cx = seg.x*TILE + TILE/2 + wob;
    const cy = seg.y*TILE + TILE/2 + (G.spaghetti > 0 ? Math.cos(t*5.5 + i*0.7)*3.0 : 0);

    const sz = TILE * 0.88 * taper;
    g2.save();
    g2.translate(cx, cy);

    /* тело: чёрный квадрат с белой обводкой */
    g2.fillStyle = '#0a0a0c';
    g2.fillRect(-sz/2, -sz/2, sz, sz);

    g2.strokeStyle = '#ffffff';
    g2.lineWidth = i === 0 ? 2.2 : 1.6;
    g2.strokeRect(-sz/2, -sz/2, sz, sz);

    g2.restore();
  }
}

function drawObjects(){
  const t = performance.now()/1000;

  for (const b of G.barrels){
    g2.drawImage(SPR.barrel, b.x*TILE, b.y*TILE);
  }

  for (const p of G.pickups){
    const bob = Math.sin(t*3 + p.x*1.3 + p.y)*2.2;
    const img = p.t === 'med' ? SPR.medkit : p.t === 'ammo' ? SPR.ammo : SPR.soul;
    if (p.t === 'soul'){
      /* синее свечение обычным наложением: на светлой карте 'lighter'
         выбеливал сферу до неузнаваемости */
      const px = p.x*TILE + TILE/2;
      const py = p.y*TILE + TILE/2 + bob;
      const pulse = 0.85 + 0.15*Math.sin(t*3.4);

      const glow = g2.createRadialGradient(px, py, 2, px, py, TILE*1.05*pulse);
      glow.addColorStop(0,   'rgba(70,140,240,0.42)');
      glow.addColorStop(0.55,'rgba(40,95,200,0.20)');
      glow.addColorStop(1,   'rgba(20,50,140,0)');
      g2.fillStyle = glow;
      g2.beginPath(); g2.arc(px, py, TILE*1.05*pulse, 0, 7); g2.fill();

      g2.fillStyle = 'rgba(0,0,0,.35)';
      g2.beginPath(); g2.ellipse(p.x*TILE+TILE/2, p.y*TILE+TILE-3, 10, 3.5, 0,0,7); g2.fill();

      g2.drawImage(img, p.x*TILE, p.y*TILE + bob);
    } else if (p.t === 'med'){
      /* сердечко выступает за клетку — компенсируем отступом */
      g2.fillStyle = 'rgba(0,0,0,.4)';
      g2.beginPath();
      g2.ellipse(p.x*TILE+TILE/2, p.y*TILE+TILE-3, 13, 4.5, 0,0,7);
      g2.fill();
      g2.drawImage(img, p.x*TILE - MED_PAD, p.y*TILE - MED_PAD + bob);
    } else {
      g2.fillStyle = 'rgba(0,0,0,.4)';
      g2.beginPath(); g2.ellipse(p.x*TILE+TILE/2, p.y*TILE+TILE-3, 11, 4, 0,0,7); g2.fill();
      g2.drawImage(img, p.x*TILE, p.y*TILE + bob);
    }
  }
}

/* Враги: рогатые твари, ползут к тебе */
/* ВРАГИ — чёрные фигуры с белой обводкой и рогами, без лица.
   Тот же визуальный язык, что у змейки: чёрный силуэт, белый контур. */
function drawHunters(){
  const t = performance.now()/1000;

  for (const im of G.hunters){
    const cx = im.x*TILE + TILE/2;
    const cy = im.y*TILE + TILE/2 + Math.sin(t*3 + im.x)*1.2;
    const r  = TILE*0.36;

    /* слабое белое свечение — чтобы читались на чёрном полу */
    const gr = g2.createRadialGradient(cx, cy, 2, cx, cy, TILE*0.95);
    gr.addColorStop(0, 'rgba(255,255,255,.12)');
    gr.addColorStop(1, 'rgba(255,255,255,0)');
    g2.fillStyle = gr;
    g2.beginPath(); g2.arc(cx, cy, TILE*0.95, 0, 7); g2.fill();

    /* тень */
    g2.fillStyle = 'rgba(0,0,0,.5)';
    g2.beginPath(); g2.ellipse(cx, cy+r*0.95, r*0.9, r*0.32, 0, 0, 7); g2.fill();

    /* рога — чёрные с белым контуром */
    g2.fillStyle = '#0a0a0c';
    g2.strokeStyle = '#ffffff';
    g2.lineWidth = 1.6;

    g2.beginPath();
    g2.moveTo(cx - r*0.62, cy - r*0.55);
    g2.lineTo(cx - r*1.15, cy - r*1.55);
    g2.lineTo(cx - r*0.15, cy - r*0.95);
    g2.closePath(); g2.fill(); g2.stroke();

    g2.beginPath();
    g2.moveTo(cx + r*0.62, cy - r*0.55);
    g2.lineTo(cx + r*1.15, cy - r*1.55);
    g2.lineTo(cx + r*0.15, cy - r*0.95);
    g2.closePath(); g2.fill(); g2.stroke();

    /* тушка: чёрный круг с белой обводкой */
    g2.fillStyle = '#0a0a0c';
    g2.beginPath(); g2.arc(cx, cy, r, 0, 7); g2.fill();

    g2.strokeStyle = '#ffffff';
    g2.lineWidth = 2;
    g2.beginPath(); g2.arc(cx, cy, r, 0, 7); g2.stroke();

    /* три отростка снизу */
    g2.lineWidth = 1.6;
    for (let k=-1;k<=1;k++){
      g2.beginPath();
      g2.moveTo(cx + k*r*0.5, cy + r*0.85);
      g2.lineTo(cx + k*r*0.62, cy + r*1.38);
      g2.stroke();
    }
  }
}

/* пуля: яркое ядро, свечение и затухающий след */
function drawBullets(){
  for (const b of G.bullets){
    const n = b.trail.length / 2;
    for (let i = 0; i < n; i++){
      const k = i / Math.max(1, n);
      g2.globalAlpha = 0.10 + k*0.55;
      g2.fillStyle = k > .65 ? '#d6ecff' : '#3d8ef0';
      const r = 1.4 + k*3.2;
      g2.fillRect(b.trail[i*2] - r/2, b.trail[i*2+1] - r/2, r, r);
    }
    g2.globalAlpha = 1;

    const pulse = 0.75 + 0.25*Math.sin(performance.now()/45);
    const gr = g2.createRadialGradient(b.x, b.y, 0, b.x, b.y, 13*pulse);
    gr.addColorStop(0,    'rgba(255,255,255,1)');
    gr.addColorStop(0.28, 'rgba(160,220,255,.95)');
    gr.addColorStop(0.6,  'rgba(60,140,255,.5)');
    gr.addColorStop(1,    'rgba(20,60,200,0)');
    g2.fillStyle = gr;
    g2.beginPath(); g2.arc(b.x, b.y, 13*pulse, 0, 7); g2.fill();

    g2.fillStyle = '#eaf4ff';
    g2.beginPath(); g2.arc(b.x, b.y, 2.8, 0, 7); g2.fill();
  }
}

function drawParticles(){
  for (const p of G.particles){
    const a = clamp(p.life/p.max, 0, 1);
    g2.globalAlpha = a;
    g2.fillStyle = p.col;
    g2.fillRect(p.x - p.r/2, p.y - p.r/2, p.r, p.r);
  }
  g2.globalAlpha = 1;
}

/* Детерминированное «случайное» от двух чисел.
   Нужно узору проплешин: если брать Math.random(), полосы будут
   мерцать и дёргаться вместо того, чтобы ехать ровно. */
function seedOf(a, b){
  let h = (a*374761393 + b*668265263) | 0;
  h = Math.imul(h ^ (h >>> 13), 1274126177);
  return Math.abs(h ^ (h >>> 16));
}

function render(){
  const t = performance.now()/1000;

  g2.setTransform(1,0,0,1,0,0);
  g2.fillStyle = '#07060a';
  g2.fillRect(0,0,W,H);

  /* тряска */
  const sh = G.shake;
  const ox = sh ? (Math.random()*2-1)*sh : 0;
  const oy = sh ? (Math.random()*2-1)*sh : 0;

  g2.save();
  g2.translate(ox, oy);

  /* арена */
  g2.drawImage(arena, 0, 0);

  drawObjects();
  drawHunters();
  if (G.state !== 'over') drawSnake();
  drawBullets();
  drawParticles();

  /* ---------------- РАДУЖНЫЕ СТЕНЫ ---------------- */
  /* кайма перерисовывается каждый кадр поверх статичной арены */
  drawRainbowEdges(t);

  /* сетка-разметка поверх, еле заметная */
  g2.strokeStyle = 'rgba(120,180,90,.055)';
  g2.lineWidth = 1;
  g2.beginPath();
  for (let x=0;x<=COLS;x++){ g2.moveTo(x*TILE+.5, 0); g2.lineTo(x*TILE+.5, ARENA_H); }
  for (let y=0;y<=ROWS;y++){ g2.moveTo(0, y*TILE+.5); g2.lineTo(ARENA_W, y*TILE+.5); }
  g2.stroke();

  /* ───────────────────────── ДВОЕНИЕ В ГЛАЗАХ ─────────────────────────
     Раньше здесь копировался только фон arena, поэтому двоились стены,
     а змейка, Враги и пули оставались чёткими — эффекта не получалось.

     Теперь берём СНИМОК ВСЕЙ СЦЕНЫ и накладываем его ещё три раза
     со сдвигом. Двоится всё разом: змейка, Враги, блоки, пули, искры.
     Экран при этом не делится — просто картинка плывёт и троится. */
  /* ─── ГОЛОД: красная виньетка по краям, пульсирует к концу ───
     Рисуем ДО двоения и вспышек, чтобы не перекрывать эффекты событий. */
  if (G.state === 'play' && G.hunger <= 10){
    const k = clamp(1 - G.hunger/10, 0, 1);          /* 0 вначале, 1 к смерти */
    const pulse = 0.55 + 0.45 * Math.sin(performance.now()/1000 * (4 + k*7));
    const a = (0.10 + k*0.30) * pulse;

    const vg = g2.createRadialGradient(
      ARENA_W/2, ARENA_H/2, Math.min(ARENA_W, ARENA_H)*0.30,
      ARENA_W/2, ARENA_H/2, Math.max(ARENA_W, ARENA_H)*0.62
    );
    vg.addColorStop(0, 'rgba(255,40,16,0)');
    vg.addColorStop(1, 'rgba(255,40,16,' + a.toFixed(3) + ')');
    g2.fillStyle = vg;
    g2.fillRect(0, 0, ARENA_W, ARENA_H);
  }

  if (G.double > 0){
    const fade = Math.min(1, G.double/2.5);
    const tt = performance.now()/1000;
    const amp = 22 * fade;

    /* сдвиги качаются в противофазе — двойник «дышит» вокруг картинки */
    const dx = Math.sin(tt*2.3) * amp;
    const dy = Math.cos(tt*1.7) * amp * 0.65;

    /* снимаем то, что уже нарисовано */
    const snap = doubleLayer();
    const sc = snap.getContext('2d');
    sc.setTransform(1,0,0,1,0,0);
    sc.clearRect(0, 0, ARENA_W, ARENA_H);
    sc.drawImage(cv, 0, 0, ARENA_W, ARENA_H, 0, 0, ARENA_W, ARENA_H);

    g2.save();
    g2.globalCompositeOperation = 'screen';

    /* второй слой — основной двойник */
    g2.globalAlpha = 0.55 * fade;
    g2.drawImage(snap, dx, dy);

    /* третий — в другую сторону, слабее */
    g2.globalAlpha = 0.32 * fade;
    g2.drawImage(snap, -dx*0.85, -dy*0.85);

    /* четвёртый — дальний призрак, даёт «троение» */
    g2.globalAlpha = 0.17 * fade;
    g2.drawImage(snap, dx*1.7, dy*1.7 + 7);

    g2.restore();

    /* розовая пелена — как расфокус */
    g2.fillStyle = `rgba(150,50,170,${0.06*fade})`;
    g2.fillRect(0, 0, ARENA_W, ARENA_H);
  }

  /* виньетка */
  const vg = g2.createRadialGradient(ARENA_W/2, ARENA_H/2, ARENA_H*0.28,
                                     ARENA_W/2, ARENA_H/2, ARENA_H*0.92);
  vg.addColorStop(0, 'rgba(0,0,0,0)');
  vg.addColorStop(1, 'rgba(0,0,0,.72)');
  g2.fillStyle = vg; g2.fillRect(0,0,ARENA_W,ARENA_H);

  /* мигание света */
  /* МЕРЦАЮЩИЙ СВЕТ: экран то полностью чёрный, то обычный.
     Раньше заливка была полупрозрачной, и получалась дрожащая полутьма.
     Теперь переключение бинарное — либо чернота, либо ничего.
     Темп держим как раньше, около четырнадцати раз в секунду:
     чаще — глаз сливает мигание в ровное затемнение. */
  if (G.flicker > 0){
    const phase = Math.floor(performance.now() / 72) % 2;
    if (phase === 0){
      g2.fillStyle = '#000000';
      g2.fillRect(0, 0, ARENA_W, ARENA_H);
    }
  }

  /* БЕЛЫЙ ШУМ: экран рассыпается на помехи.
     Дрожащие полосы, поле светлых пикселей и редкие тёмные провалы. */
  /* ══════════ БЕЛЫЙ ШУМ: РВАНЫЕ ПОЛОСЫ ══════════

     Раньше это была полупрозрачная пелена с рябью: экран мутнел весь
     разом, но картинка оставалась видна. Теперь наоборот — полосы
     плотные, за ними не видно ничего, зато в проплешинах и между
     полосами всё чисто, без дымки.

     ГЕОМЕТРИЯ ПОДОБРАНА ПОД ИГРАБЕЛЬНОСТЬ:
       8 полос по 22px, шаг около 102px → чистый просвет 80px.
       Змейка занимает 32px, то есть помещается в просвет с запасом
       в два с половиной раза и всегда читается.

     Проплешины рвут полосу по горизонтали: 70–190px закрашено,
     30–85px чисто. В сумме полосы закрывают около 15% экрана —
     заметно, но не слепота. Узор у каждой полосы свой, иначе они
     сливались бы в решётку. */
  if (G.noise > 0){
    const fade  = Math.min(1, G.noise/2.5);
    const BANDS = 8;                    /* сколько полос на экране */
    const BH    = 22;                   /* толщина полосы */
    const SPD   = 110;                  /* скорость подъёма, px/с */

    const span = ARENA_H + BH*2;        /* путь с запасом за края */
    const step = span / BANDS;
    const prog = (performance.now()/1000 * SPD) % step;

    g2.fillStyle = `rgba(255,255,255,${fade})`;

    for (let i = 0; i < BANDS; i++){
      /* снизу вверх: с ростом prog y уменьшается. Полоса уходит за
         верхний край и возвращается снизу — стык незаметен, потому
         что шаг ровный. */
      const y = ARENA_H + BH - ((i*step + prog) % span);
      if (y > ARENA_H || y + BH < 0) continue;

      /* у каждой полосы свой сдвиг узора, чтобы проплешины не
         выстраивались в вертикальные столбцы */
      let x = -((i*47) % 130);
      let k = 0;

      while (x < ARENA_W){
        const seg = 70 + (seedOf(i, k)     % 121);   /* 70..190 */
        const gap = 30 + (seedOf(i, k + 1) % 56);    /* 30..85  */

        g2.fillRect(x, y, seg, BH);

        x += seg + gap;
        k += 2;
      }
    }
  }

  /* ТЕМНОТА — ФОНАРИК.
     Светит узким конусом туда, куда ползёт змейка, и гаснет о стены.
     Вокруг головы остаётся слабый полумрак, чтобы не слепнуть вплотную. */
  if (G.dark > 0){
    const h = G.snake[0];
    const hx = h ? h.x*TILE + TILE/2 : ARENA_W/2;
    const hy = h ? h.y*TILE + TILE/2 : ARENA_H/2;
    const fade = Math.min(1, G.dark/2);

    /* направление взгляда */
    let dx = G.dir.x, dy = G.dir.y;
    const dl = Math.hypot(dx, dy) || 1;
    dx /= dl; dy /= dl;
    const target = Math.atan2(dy, dx);

    /* плавный доворот конуса: при повороте свет не прыгает рывком */
    let diff = target - G.lightAng;
    while (diff >  Math.PI) diff -= Math.PI*2;
    while (diff < -Math.PI) diff += Math.PI*2;
    G.lightAng += diff * 0.28;
    const ang = G.lightAng;

    const REACH = 15.0 * TILE;
    const HALF  = 0.62;

    const dc = darkLayer();
    const dg = dc.getContext('2d');
    dg.setTransform(1,0,0,1,0,0);
    dg.globalCompositeOperation = 'source-over';
    dg.clearRect(0, 0, ARENA_W, ARENA_H);
    dg.fillStyle = `rgba(0,0,0,${0.985*fade})`;
    dg.fillRect(0, 0, ARENA_W, ARENA_H);

    /* пробиваем конус в темноте */
    dg.globalCompositeOperation = 'destination-out';
    const grd = dg.createRadialGradient(hx, hy, TILE*0.4, hx, hy, REACH);
    grd.addColorStop(0,    'rgba(0,0,0,1)');
    grd.addColorStop(0.45, 'rgba(0,0,0,0.97)');
    grd.addColorStop(0.78, 'rgba(0,0,0,0.55)');
    grd.addColorStop(1,    'rgba(0,0,0,0)');
    dg.fillStyle = grd;
    flashlightPath(dg, hx, hy, ang, HALF, REACH);
    dg.fill();

    /* слабый ореол вокруг головы */
    const near = dg.createRadialGradient(hx, hy, 0, hx, hy, TILE*1.6);
    near.addColorStop(0, 'rgba(0,0,0,0.50)');
    near.addColorStop(1, 'rgba(0,0,0,0)');
    dg.fillStyle = near;
    dg.beginPath(); dg.arc(hx, hy, TILE*1.6, 0, 7); dg.fill();

    /* ── ТОЧНАЯ ТЕНЬ ──
       Все тени заливаются ОДНИМ путём с обычной заливкой (nonzero).
       Так пересекающиеся тени складываются, а не вычитаются: раньше
       при evenodd общая область двух теней становилась светлой.
       Затем из тени вырезаются стены, до которых реально доходит
       свет — иначе тень соседа гасила бы их. */
    const shadows = shadowShapes(hx, hy, ang, HALF, REACH);
    if (shadows.length){
      dg.globalCompositeOperation = 'source-over';
      dg.fillStyle = `rgba(0,0,0,${0.985*fade})`;
      dg.beginPath();

      for (const sh of shadows){
        const p = sh.poly;
        if (!p || p.length < 3) continue;
        dg.moveTo(p[0][0], p[0][1]);
        for (let k = 1; k < p.length; k++) dg.lineTo(p[k][0], p[k][1]);
        dg.closePath();
      }
      dg.fill();

      /* возвращаем свет на освещённые стены тем же градиентом конуса,
         чтобы дальние стены были тусклее ближних */
      let anyVisible = false;
      dg.beginPath();
      for (const sh of shadows){
        if (!sh.visible) continue;
        const w = sh.wall;
        dg.rect(w[0], w[1], w[2], w[3]);
        anyVisible = true;
      }
      if (anyVisible){
        dg.globalCompositeOperation = 'destination-out';
        dg.fillStyle = grd;
        dg.fill();
      }
    }

    g2.drawImage(dc, 0, 0);

    /* тёплый отблеск самого фонарика */
    const glow = g2.createRadialGradient(hx, hy, 0, hx, hy, TILE*1.5);
    glow.addColorStop(0,   `rgba(255,240,190,${0.20*fade})`);
    glow.addColorStop(0.5, `rgba(255,220,150,${0.08*fade})`);
    glow.addColorStop(1,   'rgba(255,210,120,0)');
    g2.fillStyle = glow;
    g2.beginPath(); g2.arc(hx, hy, TILE*1.5, 0, 7); g2.fill();
  }

  /* вспышка */
  if (G.flash > 0){
    g2.globalAlpha = G.flash;
    g2.fillStyle = G.flashCol;
    g2.fillRect(0,0,ARENA_W,ARENA_H);
    g2.globalAlpha = 1;
  }

  /* объявление */
  if (G.ann.dur > 0 && G.ann.t < G.ann.dur){
    const k = G.ann.t / G.ann.dur;
    const pop = k < .16 ? k/.16 : 1;
    const fade = k > .72 ? 1 - (k-.72)/.28 : 1;
    g2.save();
    g2.globalAlpha = clamp(fade, 0, 1);
    g2.translate(ARENA_W/2, ARENA_H*0.20);
    g2.scale(0.85 + pop*0.15, 0.85 + pop*0.15);
    g2.textAlign = 'center';
    g2.font = 'bold 40px "Courier New",monospace';
    g2.lineWidth = 5; g2.strokeStyle = '#1a0503';
    g2.strokeText(G.ann.text, 0, 0);
    g2.fillStyle = G.ann.col;
    g2.shadowColor = G.ann.col; g2.shadowBlur = 22;
    g2.fillText(G.ann.text, 0, 0);
    g2.restore();
  }
  g2.restore();

  try { drawHUD(); } catch(e){ /* HUD не должен ронять арену */ }

  /* подсказка, пока не сделан первый ход */
  if (G.state === 'play' && !G.armed){
    const p = 0.55 + 0.45*Math.sin(performance.now()/240);
    g2.save();
    g2.globalAlpha = p;
    g2.textAlign = 'center';
    g2.font = 'bold 28px "Courier New",monospace';
    g2.lineWidth = 5; g2.strokeStyle = '#0d0503';
    g2.strokeText('ЖМИ WASD ИЛИ СТРЕЛКИ', ARENA_W/2, ARENA_H*0.60);
    g2.fillStyle = '#c2d86a';
    g2.shadowColor = '#c2d86a'; g2.shadowBlur = 16;
    g2.fillText('ЖМИ WASD ИЛИ СТРЕЛКИ', ARENA_W/2, ARENA_H*0.60);
    g2.shadowBlur = 0;
    g2.font = '15px "Courier New",monospace';
    g2.fillStyle = '#8a7a5c';
    g2.fillText('змейка не двинется, пока не решишься', ARENA_W/2, ARENA_H*0.60 + 26);
    g2.restore();
  }
}

/* ================================================================ ЭКРАН == */
/* вписать строку в ширину: режем по символам, но ровно по пикселям,
   поэтому ни одна буква не пропадаетт и многоточие ставится по делу */
function fitText(str, maxW){
  if (!str) return '';
  if (g2.measureText(str).width <= maxW) return str;
  let out = str;
  while (out.length > 1 && g2.measureText(out + '…').width > maxW)
    out = out.slice(0, -1);
  return out + '…';
}

/* контур сердца — общий для HUD и для спрайта на земле */
function heartPath(g, x, y, r){
  g.beginPath();
  g.moveTo(x, y + r*0.35);
  g.bezierCurveTo(x - r*1.25, y - r*0.55, x - r*0.45, y - r*1.35, x, y - r*0.62);
  g.bezierCurveTo(x + r*0.45, y - r*1.35, x + r*1.25, y - r*0.55, x, y + r*0.35);
  g.closePath();
}

/* сердечко в HUD: full=false — пустой контур */
function drawHeart(x, y, r, fill, stroke){
  heartPath(g2, x, y, r);
  g2.fillStyle = fill;
  g2.fill();
  if (stroke){
    g2.strokeStyle = stroke;
    g2.lineWidth = 1.5;
    g2.stroke();
  }
}

function drawBar(x, y, w, h, frac, colA, colB, label, value){
  g2.fillStyle = '#160d0a'; g2.fillRect(x, y, w, h);
  const grd = g2.createLinearGradient(x, y, x, y+h);
  grd.addColorStop(0, colB); grd.addColorStop(1, colA);
  g2.fillStyle = grd;
  g2.fillRect(x+2, y+2, Math.max(0, (w-4)*clamp(frac,0,1)), h-4);
  g2.strokeStyle = '#5c4a2a'; g2.lineWidth = 2;
  g2.strokeRect(x+.5, y+.5, w-1, h-1);
  g2.fillStyle = 'rgba(255,255,255,.18)';
  g2.fillRect(x+2, y+2, Math.max(0,(w-4)*clamp(frac,0,1)), 3);
  g2.font = 'bold 11px "Courier New",monospace';
  g2.textAlign = 'left';
  g2.fillStyle = '#c9a06a';
  g2.fillText(label, x+5, y+h-6);
  g2.textAlign = 'right';
  g2.fillStyle = '#f0e0c0';
  g2.fillText(value, x+w-5, y+h-6);
}

function drawHUD(){
